{
  "id": "nunjucks",
  "name": "Nunjucks",
  "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "traditionalMarkupLanguage": true,
  "extensions": [".njk", ".nunjucks", ".html.njk"],
  "keywords": [
    "and",
    "as",
    "asyncAll",
    "asyncEach",
    "block",
    "call",
    "case",
    "default",
    "else",
    "elif",
    "endblock",
    "endcall",
    "endfor",
    "endif",
    "endmacro",
    "endraw",
    "endset",
    "endswitch",
    "endverbatim",
    "endwith",
    "extends",
    "false",
    "filter",
    "for",
    "from",
    "if",
    "import",
    "in",
    "include",
    "is",
    "macro",
    "none",
    "not",
    "or",
    "raw",
    "recursive",
    "set",
    "switch",
    "true",
    "verbatim",
    "with"
  ],
  "controlStatements": [
    "and",
    "case",
    "default",
    "else",
    "elif",
    "endfor",
    "endif",
    "for",
    "if",
    "in",
    "is",
    "not",
    "or",
    "switch",
    "with"
  ],
  "types": [],
  "constants": ["false", "none", "true"],
  "comments": {
    "blockStart": "{#",
    "blockEnd": "#}"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["{% block", "{% for", "{% if", "{% macro", "{% with"],
  "unindentBefore": [
    "{% endblock",
    "{% endfor",
    "{% endif",
    "{% endmacro",
    "{% endwith"
  ]
}
