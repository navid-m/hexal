{
  "id": "mlir",
  "name": "MLIR",
  "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".mlir"],
  "keywords": [
    "affine",
    "alloc",
    "arith",
    "block",
    "builtin",
    "call",
    "cf",
    "cond_br",
    "constant",
    "dealloc",
    "dim",
    "else",
    "func",
    "gpu",
    "index",
    "linalg",
    "load",
    "llvm",
    "memref",
    "module",
    "return",
    "scf",
    "store",
    "tensor",
    "then",
    "vector",
    "yield"
  ],
  "controlStatements": [
    "br",
    "cond_br",
    "else",
    "for",
    "if",
    "return",
    "scf.for",
    "scf.if",
    "scf.while",
    "then",
    "yield"
  ],
  "types": [
    "bf16",
    "f16",
    "f32",
    "f64",
    "i1",
    "i8",
    "i16",
    "i32",
    "i64",
    "index",
    "memref",
    "none",
    "tensor",
    "tuple",
    "vector"
  ],
  "constants": ["false", "true"],
  "comments": {
    "line": "//",
    "blockStart": "/*",
    "blockEnd": "*/"
  },
  "strings": {
    "quoteCharacters": ["\""],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["{", "[", "("],
  "unindentBefore": ["}", "]", ")"]
}
