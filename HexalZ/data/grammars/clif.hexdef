{
  "id": "clif",
  "name": "Cranelift IR",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 8 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".clif"],
  "keywords": [
    "target",
    "function",
    "block",
    "jump",
    "fallthrough",
    "brif",
    "br_table",
    "return",
    "return_call",
    "return_call_indirect",
    "call",
    "call_indirect",
    "global_value",
    "stack_load",
    "stack_store",
    "stack_addr",
    "heap_load",
    "heap_store",
    "heap_addr",
    "table_load",
    "table_store",
    "table_addr",
    "iadd",
    "iadd_imm",
    "isub",
    "isub_imm",
    "imul",
    "imul_imm",
    "sdiv",
    "sdiv_imm",
    "udiv",
    "udiv_imm",
    "srem",
    "srem_imm",
    "urem",
    "urem_imm",
    "ineg",
    "iabs",
    "iand",
    "iand_imm",
    "ior",
    "ior_imm",
    "ixor",
    "ixor_imm",
    "ishl",
    "ishl_imm",
    "sshr",
    "sshr_imm",
    "ushr",
    "ushr_imm",
    "icmp",
    "icmp_imm",
    "ifcmp",
    "ifcmp_imm",
    "fadd",
    "fadd_imm",
    "fsub",
    "fsub_imm",
    "fmul",
    "fmul_imm",
    "fdiv",
    "fdiv_imm",
    "fneg",
    "fabs",
    "fsqrt",
    "fma",
    "fcmp",
    "iconst",
    "f32const",
    "f64const",
    "bconst",
    "vconst",
    "null",
    "bitcast",
    "ireduce",
    "uextend",
    "sextend",
    "fpromote",
    "fdemote",
    "fcvt_to_sint",
    "fcvt_to_uint",
    "fcvt_from_sint",
    "fcvt_from_uint",
    "load",
    "store",
    "load_notrap",
    "store_notrap",
    "select",
    "select_spectre_guard",
    "bitselect",
    "trap",
    "trapnz",
    "trapz",
    "resumable_trap",
    "resumable_trapnz",
    "debugtrap",
    "splat",
    "extractlane",
    "insertlane",
    "shuffle",
    "vsplit",
    "vconcat",
    "isplit",
    "iconcat"
  ],
  "controlStatements": [
    "jump",
    "brif",
    "br_table",
    "return",
    "return_call",
    "return_call_indirect",
    "trap",
    "trapnz",
    "trapz"
  ],
  "types": [
    "i8",
    "i16",
    "i32",
    "i64",
    "i128",
    "u8",
    "u16",
    "u32",
    "u64",
    "u128",
    "f16",
    "f32",
    "f64",
    "b1",
    "b8",
    "b16",
    "b32",
    "b64",
    "b128"
  ],
  "constants": ["true", "false", "inf", "NaN"],
  "comments": {
    "line": ";"
  },
  "strings": {
    "quoteCharacters": ["\""],
    "escapeCharacter": "\\"
  },
  "numbers": true
}
