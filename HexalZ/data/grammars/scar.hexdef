{
  "id": "scar",
  "name": "Scar",
  "indentation": {
    "style": "tabs",
    "width": 4,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".scar"],
  "keywords": [
    "addr",
    "add",
    "alloc",
    "append",
    "as",
    "as_mut",
    "capacity",
    "def",
    "defer",
    "deref",
    "end",
    "enum",
    "extern",
    "fn",
    "free",
    "get",
    "guard",
    "in",
    "insert",
    "interface",
    "link",
    "list",
    "match",
    "memcpy",
    "memmove",
    "memset",
    "mut",
    "parallel",
    "print",
    "pub",
    "puts",
    "realloc",
    "ref",
    "reserve",
    "set",
    "test",
    "type",
    "typeset",
    "union",
    "use",
    "val",
    "var"
  ],
  "controlStatements": [
    "break",
    "continue",
    "defer",
    "elif",
    "else",
    "for",
    "guard",
    "if",
    "match",
    "parallel",
    "return",
    "when"
  ],
  "types": [
    "bool",
    "f32",
    "f64",
    "i8",
    "i16",
    "i32",
    "i64",
    "isize",
    "u8",
    "u16",
    "u32",
    "u64",
    "usize",
    "void"
  ],
  "constants": ["error", "false", "none", "ok", "true"],
  "comments": {
    "line": "#"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": [
    "def",
    "defer",
    "elif",
    "else",
    "enum",
    "for",
    "guard",
    "if",
    "interface",
    "match",
    "parallel",
    "type",
    "typeset",
    "union",
    "when"
  ],
  "unindentBefore": ["elif", "else", "end", "when"]
}
