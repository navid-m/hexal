{
  "id": "groovy",
  "name": "Groovy",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 8 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".groovy", ".gvy", ".gy", ".gsh"],
  "keywords": [
    "abstract",
    "as",
    "assert",
    "break",
    "case",
    "catch",
    "class",
    "const",
    "continue",
    "def",
    "default",
    "do",
    "else",
    "enum",
    "extends",
    "final",
    "finally",
    "for",
    "goto",
    "if",
    "implements",
    "import",
    "in",
    "instanceof",
    "interface",
    "native",
    "new",
    "package",
    "private",
    "protected",
    "public",
    "return",
    "static",
    "strictfp",
    "super",
    "switch",
    "synchronized",
    "this",
    "throw",
    "throws",
    "trait",
    "transient",
    "try",
    "volatile",
    "while",
    "mixin",
    "property",
    "closure",
    "it",
    "owner",
    "delegate",
    "with",
    "each",
    "eachWithIndex",
    "collect",
    "collectEntries",
    "find",
    "findAll",
    "findIndexOf",
    "inject",
    "every",
    "any",
    "grep",
    "groupBy",
    "sort",
    "println",
    "printf",
    "print"
  ],
  "controlStatements": [
    "break",
    "case",
    "catch",
    "continue",
    "default",
    "do",
    "else",
    "finally",
    "for",
    "if",
    "return",
    "switch",
    "throw",
    "try",
    "while",
    "assert"
  ],
  "types": [
    "boolean",
    "byte",
    "char",
    "double",
    "float",
    "int",
    "long",
    "short",
    "void",
    "BigDecimal",
    "BigInteger",
    "Boolean",
    "Byte",
    "Character",
    "Closure",
    "Double",
    "Float",
    "Integer",
    "List",
    "Long",
    "Map",
    "Object",
    "Range",
    "Set",
    "Short",
    "String",
    "StringBuilder"
  ],
  "constants": ["true", "false", "null"],
  "comments": {
    "line": "//",
    "blockStart": "/*",
    "blockEnd": "*/"
  },
  "strings": {
    "quoteCharacters": ["\"\"\"", "'''", "\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true
}
