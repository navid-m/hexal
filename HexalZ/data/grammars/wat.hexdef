{
  "id": "wat",
  "name": "WebAssembly Text",
  "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".wat", ".wast"],
  "keywords": [
    "module",
    "type",
    "import",
    "export",
    "func",
    "param",
    "result",
    "local",
    "global",
    "memory",
    "table",
    "data",
    "elem",
    "start",
    "then",
    "else",
    "item",
    "field",
    "struct",
    "array",
    "rec",
    "sub",
    "mut",
    "quote"
  ],
  "controlStatements": [
    "block",
    "loop",
    "if",
    "br",
    "br_if",
    "br_table",
    "call",
    "call_indirect",
    "return",
    "return_call",
    "return_call_indirect",
    "unreachable",
    "nop",
    "drop",
    "select",
    "throw",
    "rethrow",
    "try",
    "catch",
    "catch_all",
    "delegate"
  ],
  "types": [
    "i32",
    "i64",
    "f32",
    "f64",
    "v128",
    "funcref",
    "externref",
    "anyref",
    "eqref",
    "i31ref",
    "structref",
    "arrayref",
    "nullref",
    "exnref"
  ],
  "constants": ["true", "false"],
  "comments": {
    "line": ";;",
    "blockStart": "(;",
    "blockEnd": ";)"
  },
  "strings": {
    "quoteCharacters": ["\""],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["(", "["],
  "unindentBefore": [")", "]"]
}
