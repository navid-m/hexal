{
  "id": "ada",
  "name": "Ada",
  "indentation": {
    "style": "spaces",
    "width": 3,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".adb", ".ads", ".ada"],
  "keywords": [
    "abs",
    "abstract",
    "access",
    "aliased",
    "all",
    "array",
    "at",
    "body",
    "constant",
    "delta",
    "digits",
    "generic",
    "interface",
    "limited",
    "mod",
    "new",
    "not",
    "others",
    "overriding",
    "package",
    "parallel",
    "pragma",
    "private",
    "procedure",
    "protected",
    "range",
    "record",
    "rem",
    "renames",
    "separate",
    "some",
    "subtype",
    "synchronized",
    "tagged",
    "task",
    "type",
    "use",
    "xor"
  ],
  "controlStatements": [
    "abort",
    "accept",
    "begin",
    "case",
    "declare",
    "delay",
    "do",
    "else",
    "elsif",
    "end",
    "entry",
    "exception",
    "exit",
    "for",
    "goto",
    "if",
    "loop",
    "raise",
    "requeue",
    "return",
    "select",
    "terminate",
    "then",
    "until",
    "when",
    "while"
  ],
  "types": [
    "Boolean",
    "Integer",
    "Natural",
    "Positive",
    "Float",
    "Long_Float",
    "Long_Integer",
    "Short_Integer",
    "Character",
    "String",
    "Wide_Character",
    "Wide_String",
    "Duration",
    "Time",
    "Ada",
    "Standard",
    "System"
  ],
  "constants": ["True", "False", "Null"],
  "comments": {
    "line": "--"
  },
  "strings": {
    "quoteCharacters": ["\""]
  },
  "numbers": true,
  "indentAfter": ["is", "then", "loop", "declare", "begin", "record"],
  "unindentBefore": ["end", "else", "elsif", "when"],
  "formatter": {
    "command": "gnatpp",
    "arguments": [
      "--pipe",
      "{tmp}"
    ],
    "input": "file",
    "output": "stdout",
    "timeout": 30000
  }
}
