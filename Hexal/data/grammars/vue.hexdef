{
  "id": "vue",
  "name": "Vue",
  "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "traditionalMarkupLanguage": true,
  "extensions": [".vue"],
  "keywords": [
    "template",
    "script",
    "style",
    "setup",
    "lang",
    "scoped",
    "module",
    "src",
    "ref",
    "reactive",
    "computed",
    "watch",
    "watchEffect",
    "onMounted",
    "onUnmounted",
    "onBeforeMount",
    "onBeforeUnmount",
    "onUpdated",
    "onBeforeUpdate",
    "onActivated",
    "onDeactivated",
    "onErrorCaptured",
    "provide",
    "inject",
    "nextTick",
    "defineProps",
    "defineEmits",
    "defineExpose",
    "defineOptions",
    "defineModel",
    "withDefaults",
    "props",
    "emits",
    "expose",
    "slots",
    "attrs",
    "v-if",
    "v-else",
    "v-else-if",
    "v-for",
    "v-bind",
    "v-on",
    "v-model",
    "v-show",
    "v-slot",
    "v-html",
    "v-text",
    "v-once",
    "v-pre",
    "v-cloak",
    "v-memo",
    "transition",
    "transition-group",
    "keep-alive",
    "component",
    "slot",
    "teleport",
    "suspense",
    "router-link",
    "router-view"
  ],
  "controlStatements": [
    "if",
    "else",
    "elseif",
    "for",
    "in",
    "of",
    "break",
    "continue",
    "return",
    "switch",
    "case",
    "default",
    "try",
    "catch",
    "finally",
    "throw",
    "await"
  ],
  "types": [
    "Vue",
    "Component",
    "ComponentPublicInstance",
    "App",
    "Ref",
    "ComputedRef",
    "ShallowRef",
    "WritableComputedRef",
    "PropType",
    "InjectionKey",
    "VNode",
    "Slot",
    "SetupContext",
    "FunctionalComponent"
  ],
  "constants": ["true", "false", "null", "undefined", "NaN", "Infinity"],
  "comments": {
    "line": "//",
    "blockStart": "<!--",
    "blockEnd": "-->"
  },
  "strings": {
    "quoteCharacters": ["\"", "'", "`"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["<template", "<script", "<style", "<div", "<section"],
  "unindentBefore": ["</template", "</script", "</style", "</div", "</section"],
  "formatter": {
    "command": "prettier",
    "arguments": ["--stdin-filepath", "{path}"],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
