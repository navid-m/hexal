{
  "id": "gdscript",
  "name": "GDScript",
  "indentation": {
    "style": "tabs",
    "width": 4,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".gd"],
  "keywords": [
    "assert",
    "await",
    "breakpoint",
    "class",
    "class_name",
    "const",
    "enum",
    "export",
    "extends",
    "func",
    "in",
    "is",
    "null",
    "onready",
    "pass",
    "preload",
    "self",
    "signal",
    "static",
    "super",
    "tool",
    "var",
    "void",
    "yield",
    "namespace",
    "trait",
    "when",
    "setget",
    "remote",
    "master",
    "puppet",
    "remotesync",
    "mastersync",
    "puppetsync",
    "sync",
    "owner",
    "parent"
  ],
  "controlStatements": [
    "break",
    "continue",
    "elif",
    "else",
    "for",
    "if",
    "match",
    "return",
    "while"
  ],
  "types": [
    "bool",
    "int",
    "float",
    "String",
    "Vector2",
    "Vector2i",
    "Vector3",
    "Vector3i",
    "Vector4",
    "Vector4i",
    "Rect2",
    "Rect2i",
    "Transform2D",
    "Transform3D",
    "Color",
    "NodePath",
    "RID",
    "Array",
    "Dictionary",
    "PackedByteArray",
    "PackedInt32Array",
    "PackedInt64Array",
    "PackedFloat32Array",
    "PackedFloat64Array",
    "PackedStringArray",
    "PackedVector2Array",
    "PackedVector3Array",
    "PackedColorArray",
    "Object",
    "Node",
    "Node2D",
    "Node3D",
    "Control",
    "Resource",
    "RefCounted",
    "SceneTree"
  ],
  "constants": ["true", "false", "null", "PI", "TAU", "INF", "NAN"],
  "comments": {
    "line": "#"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": [":"],
  "unindentBefore": ["elif", "else:"],
  "formatter": {
    "command": "gdformat",
    "arguments": ["-"],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
