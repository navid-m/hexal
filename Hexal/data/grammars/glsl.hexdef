{
  "id": "glsl",
  "name": "GLSL",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".gdshader", ".shader", ".vs", ".glsl"],
  "keywords": [
    "attribute",
    "buffer",
    "centroid",
    "coherent",
    "const",
    "flat",
    "in",
    "inout",
    "invariant",
    "layout",
    "lowp",
    "mediump",
    "noperspective",
    "out",
    "patch",
    "precision",
    "precise",
    "readonly",
    "restrict",
    "sample",
    "shared",
    "smooth",
    "struct",
    "subroutine",
    "uniform",
    "varying",
    "volatile",
    "writeonly"
  ],
  "controlStatements": [
    "break",
    "case",
    "continue",
    "default",
    "discard",
    "do",
    "else",
    "for",
    "if",
    "return",
    "switch",
    "while"
  ],
  "types": [
    "bool",
    "bvec2",
    "bvec3",
    "bvec4",
    "dmat2",
    "dmat3",
    "dmat4",
    "double",
    "dvec2",
    "dvec3",
    "dvec4",
    "float",
    "image2D",
    "int",
    "isampler2D",
    "ivec2",
    "ivec3",
    "ivec4",
    "mat2",
    "mat3",
    "mat4",
    "mat2x2",
    "mat2x3",
    "mat2x4",
    "mat3x2",
    "mat3x3",
    "mat3x4",
    "mat4x2",
    "mat4x3",
    "mat4x4",
    "sampler1D",
    "sampler2D",
    "sampler2DArray",
    "sampler3D",
    "samplerCube",
    "samplerCubeArray",
    "uint",
    "usampler2D",
    "uvec2",
    "uvec3",
    "uvec4",
    "vec2",
    "vec3",
    "vec4",
    "void"
  ],
  "constants": [
    "false",
    "true",
    "gl_FragCoord",
    "gl_FragColor",
    "gl_FragDepth",
    "gl_InstanceID",
    "gl_Position",
    "gl_VertexID"
  ],
  "comments": {
    "line": "//",
    "blockStart": "/*",
    "blockEnd": "*/"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true
}
