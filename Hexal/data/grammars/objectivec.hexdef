{
  "id": "objc",
  "name": "Objective-C",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 8 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".mm", ".m", ".objc"],
  "keywords": [
    "@interface",
    "@implementation",
    "@end",
    "@protocol",
    "@class",
    "@property",
    "@synthesize",
    "@dynamic",
    "@selector",
    "@encode",
    "@defs",
    "@try",
    "@catch",
    "@finally",
    "@throw",
    "@synchronized",
    "@autoreleasepool",
    "@import",
    "@optional",
    "@required",
    "@public",
    "@private",
    "@protected",
    "@package",
    "@compatibility_alias",
    "autoreleasepool",
    "defs",
    "dynamic",
    "end",
    "encode",
    "implementation",
    "interface",
    "optional",
    "property",
    "protocol",
    "required",
    "selector",
    "synchronized",
    "synthesize",
    "alignas",
    "alignof",
    "auto",
    "class",
    "const",
    "constexpr",
    "extern",
    "inline",
    "mutable",
    "namespace",
    "noexcept",
    "operator",
    "override",
    "final",
    "private",
    "protected",
    "public",
    "register",
    "static",
    "static_assert",
    "struct",
    "template",
    "thread_local",
    "typedef",
    "typename",
    "union",
    "using",
    "virtual",
    "volatile"
  ],
  "controlStatements": [
    "break",
    "case",
    "catch",
    "continue",
    "default",
    "do",
    "else",
    "for",
    "goto",
    "if",
    "return",
    "sizeof",
    "switch",
    "throw",
    "try",
    "while"
  ],
  "types": [
    "BOOL",
    "Class",
    "CGFloat",
    "CGPoint",
    "CGRect",
    "CGSize",
    "IMP",
    "NSInteger",
    "NSUInteger",
    "SEL",
    "bool",
    "char",
    "char16_t",
    "char32_t",
    "double",
    "float",
    "id",
    "int",
    "int8_t",
    "int16_t",
    "int32_t",
    "int64_t",
    "intptr_t",
    "long",
    "ptrdiff_t",
    "short",
    "signed",
    "size_t",
    "ssize_t",
    "uint8_t",
    "uint16_t",
    "uint32_t",
    "uint64_t",
    "uintptr_t",
    "unsigned",
    "void",
    "wchar_t"
  ],
  "constants": ["YES", "NO", "nil", "Nil", "NULL", "true", "false"],
  "comments": {
    "line": "//",
    "blockStart": "/*",
    "blockEnd": "*/"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "formatter": {
    "command": "clang-format",
    "arguments": ["--assume-filename={file}"],
    "input": "stdin",
    "output": "stdout"
  },
  "fallbackLsp": {
    "name": "clangd",
    "command": "clangd",
    "arguments": [],
    "languageId": "objective-c"
  }
}
