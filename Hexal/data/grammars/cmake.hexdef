{
  "id": "cmake",
  "name": "CMake",
  "indentation": {
    "style": "spaces",
    "width": 2,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".cmake"],
  "keywords": [
    "add_compile_definitions",
    "add_compile_options",
    "add_custom_command",
    "add_custom_target",
    "add_definitions",
    "add_dependencies",
    "add_executable",
    "add_library",
    "add_link_options",
    "add_subdirectory",
    "add_test",
    "aux_source_directory",
    "build_command",
    "cmake_file_api",
    "cmake_host_system_information",
    "cmake_language",
    "cmake_minimum_required",
    "cmake_parse_arguments",
    "cmake_path",
    "cmake_policy",
    "configure_file",
    "create_test_sourcelist",
    "define_property",
    "enable_language",
    "enable_testing",
    "execute_process",
    "export",
    "fetchcontent_declare",
    "fetchcontent_getproperties",
    "fetchcontent_makeavailable",
    "file",
    "find_file",
    "find_library",
    "find_package",
    "find_path",
    "find_program",
    "get_cmake_property",
    "get_directory_property",
    "get_filename_component",
    "get_property",
    "get_source_file_property",
    "get_target_property",
    "get_test_property",
    "include",
    "include_directories",
    "include_external_msproject",
    "include_guard",
    "install",
    "install_export",
    "link_directories",
    "list",
    "load_cache",
    "load_command",
    "mark_as_advanced",
    "math",
    "message",
    "option",
    "project",
    "remove_definitions",
    "separate_arguments",
    "set",
    "set_directory_properties",
    "set_property",
    "set_source_files_properties",
    "set_target_properties",
    "set_tests_properties",
    "site_name",
    "source_group",
    "string",
    "target_compile_definitions",
    "target_compile_features",
    "target_compile_options",
    "target_include_directories",
    "target_link_directories",
    "target_link_libraries",
    "target_link_options",
    "target_precompile_headers",
    "target_sources",
    "try_compile",
    "try_run",
    "unset",
    "variable_watch"
  ],
  "controlStatements": [
    "if",
    "elseif",
    "else",
    "endif",
    "foreach",
    "endforeach",
    "while",
    "endwhile",
    "function",
    "endfunction",
    "macro",
    "endmacro",
    "break",
    "continue",
    "return",
    "block",
    "endblock"
  ],
  "types": [],
  "constants": [
    "TRUE",
    "FALSE",
    "ON",
    "OFF",
    "YES",
    "NO",
    "Y",
    "N",
    "IGNORE",
    "NOTFOUND",
    "INTERFACE",
    "PUBLIC",
    "PRIVATE",
    "REQUIRED",
    "QUIET",
    "STATUS",
    "WARNING",
    "AUTHOR_WARNING",
    "SEND_ERROR",
    "FATAL_ERROR",
    "DEPRECATION",
    "STREQUAL",
    "STRLESS",
    "STRLESS_EQUAL",
    "STRGREATER",
    "STRGREATER_EQUAL",
    "VERSION_EQUAL",
    "VERSION_LESS",
    "VERSION_LESS_EQUAL",
    "VERSION_GREATER",
    "VERSION_GREATER_EQUAL",
    "PATH_EQUAL",
    "MATCHES",
    "IN_LIST",
    "EXISTS",
    "IS_READABLE",
    "IS_WRITABLE",
    "IS_EXECUTABLE",
    "IS_DIRECTORY",
    "IS_SYMLINK",
    "IS_ABSOLUTE",
    "DEFINED",
    "COMMAND",
    "POLICY",
    "TARGET",
    "TEST",
    "ENABLE",
    "DISABLE",
    "NOT",
    "AND",
    "OR",
    "EQUAL",
    "LESS",
    "GREATER",
    "LESS_EQUAL",
    "GREATER_EQUAL"
  ],
  "comments": {
    "line": "#",
    "blockStart": "#[[",
    "blockEnd": "]]"
  },
  "strings": {
    "quoteCharacters": ["\""],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "formatter": {
    "command": "cmake-format",
    "arguments": [
      "-"
    ],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
