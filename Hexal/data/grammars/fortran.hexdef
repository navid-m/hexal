{
  "id": "fortran",
  "name": "Fortran",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [
    ".f",
    ".f77",
    ".f90",
    ".f95",
    ".f03",
    ".f08",
    ".for",
    ".ftn",
    ".fpp"
  ],
  "keywords": [
    "program",
    "endprogram",
    "module",
    "endmodule",
    "submodule",
    "contains",
    "subroutine",
    "endsubroutine",
    "function",
    "endfunction",
    "interface",
    "endinterface",
    "procedure",
    "use",
    "only",
    "implicit",
    "none",
    "integer",
    "real",
    "double",
    "precision",
    "complex",
    "logical",
    "character",
    "type",
    "class",
    "allocatable",
    "pointer",
    "target",
    "intent",
    "in",
    "out",
    "inout",
    "parameter",
    "dimension",
    "save",
    "public",
    "private",
    "protected",
    "optional",
    "external",
    "intrinsic",
    "recursive",
    "pure",
    "elemental",
    "abstract",
    "extends",
    "associate",
    "endassociate",
    "block",
    "endblock",
    "select",
    "case",
    "default",
    "where",
    "elsewhere",
    "endwhere",
    "forall",
    "endforall",
    "do",
    "enddo",
    "while",
    "cycle",
    "exit",
    "if",
    "then",
    "else",
    "elseif",
    "endif",
    "goto",
    "call",
    "return",
    "stop",
    "allocate",
    "deallocate",
    "nullify",
    "open",
    "close",
    "read",
    "write",
    "print",
    "format",
    "rewind",
    "backspace",
    "inquire",
    "common",
    "equivalence",
    "data",
    "namelist",
    "include",
    "import",
    "procedure",
    "generic",
    "final",
    "sync",
    "all",
    "memory",
    "images",
    "lock",
    "unlock",
    "critical"
  ],
  "controlStatements": [
    "if",
    "then",
    "else",
    "elseif",
    "endif",
    "do",
    "while",
    "cycle",
    "exit",
    "select",
    "case",
    "default",
    "goto",
    "call",
    "return",
    "stop",
    "allocate",
    "deallocate",
    "open",
    "close",
    "read",
    "write",
    "print",
    "format",
    "contains",
    "program",
    "module",
    "subroutine",
    "function",
    "end"
  ],
  "types": [
    "integer",
    "real",
    "double",
    "precision",
    "complex",
    "logical",
    "character",
    "type",
    "class",
    "byte",
    "kind"
  ],
  "constants": [".true.", ".false.", "true", "false"],
  "comments": {
    "line": "!"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"]
  },
  "numbers": true,
  "indentAfter": [
    "do",
    "if",
    "select",
    "type",
    "module",
    "program",
    "subroutine",
    "function",
    "interface",
    "block",
    "associate",
    "where",
    "forall",
    "critical"
  ],
  "unindentBefore": [
    "end",
    "endif",
    "enddo",
    "endmodule",
    "endprogram",
    "endsubroutine",
    "endfunction",
    "endinterface",
    "endselect",
    "endtype",
    "endblock",
    "endassociate",
    "endwhere",
    "endforall",
    "endcritical",
    "else",
    "elseif",
    "case",
    "contains"
  ],
  "formatter": {
    "command": "findent",
    "arguments": [],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
