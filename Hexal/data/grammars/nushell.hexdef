{
  "id": "nushell",
  "name": "Nushell",
  "indentation": {
    "style": "spaces",
    "width": 4,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".nu"],
  "keywords": [
    "alias",
    "all",
    "any",
    "append",
    "cd",
    "columns",
    "const",
    "cp",
    "def",
    "def-env",
    "describe",
    "each",
    "echo",
    "error",
    "export",
    "extern",
    "filter",
    "first",
    "for",
    "from",
    "get",
    "group-by",
    "help",
    "hide",
    "if",
    "in",
    "insert",
    "last",
    "length",
    "let",
    "load-env",
    "loop",
    "ls",
    "match",
    "merge",
    "metadata",
    "mkdir",
    "module",
    "mut",
    "mv",
    "open",
    "overlay",
    "par-each",
    "prepend",
    "print",
    "pwd",
    "reduce",
    "reject",
    "return",
    "rm",
    "save",
    "select",
    "set",
    "sort-by",
    "source",
    "table",
    "take",
    "to",
    "touch",
    "try",
    "update",
    "upsert",
    "use",
    "var",
    "where",
    "while",
    "with-env"
  ],
  "controlStatements": [
    "break",
    "catch",
    "continue",
    "else",
    "for",
    "if",
    "in",
    "loop",
    "match",
    "return",
    "try",
    "while"
  ],
  "types": [
    "any",
    "binary",
    "block",
    "bool",
    "closure",
    "date",
    "duration",
    "error",
    "filesize",
    "float",
    "int",
    "list",
    "nothing",
    "number",
    "path",
    "range",
    "record",
    "string",
    "table"
  ],
  "constants": ["false", "null", "nothing", "true"],
  "comments": {
    "line": "#"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["{", "[", "(", "for", "if", "match", "try", "while"],
  "unindentBefore": ["}", "]", ")", "catch", "else"],
  "formatter": {
    "command": "nufmt",
    "arguments": [
      "--stdin"
    ],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
