{
  "id": "erlang",
  "name": "Erlang",
  "indentation": {
    "style": "spaces",
    "width": 4,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".erl", ".hrl", ".escript", ".app", ".app.src"],
  "keywords": [
    "after",
    "and",
    "andalso",
    "band",
    "begin",
    "bnot",
    "bor",
    "bsl",
    "bsr",
    "bxor",
    "case",
    "catch",
    "cond",
    "div",
    "end",
    "fun",
    "if",
    "let",
    "maybe",
    "not",
    "of",
    "or",
    "orelse",
    "receive",
    "rem",
    "try",
    "when",
    "xor"
  ],
  "controlStatements": [
    "after",
    "begin",
    "case",
    "catch",
    "cond",
    "else",
    "end",
    "fun",
    "if",
    "let",
    "maybe",
    "of",
    "receive",
    "try",
    "when"
  ],
  "types": [
    "any",
    "arity",
    "atom",
    "binary",
    "bitstring",
    "boolean",
    "byte",
    "char",
    "float",
    "function",
    "integer",
    "iodata",
    "iolist",
    "list",
    "map",
    "maybe_improper_list",
    "nonempty_list",
    "none",
    "nil",
    "number",
    "pid",
    "port",
    "reference",
    "string",
    "term",
    "tuple"
  ],
  "constants": ["error", "false", "ok", "true", "undefined"],
  "comments": {
    "line": "%"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": [
    "->",
    "after",
    "begin",
    "case",
    "catch",
    "fun",
    "if",
    "of",
    "receive",
    "try"
  ],
  "unindentBefore": ["after", "catch", "else", "end"],
  "formatter": {
    "command": "erlfmt",
    "arguments": [
      "-"
    ],
    "input": "stdin",
    "output": "stdout",
    "timeout": 30000
  }
}
