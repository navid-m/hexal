{
  "id": "r",
  "name": "R",
  "indentation": {
    "style": "spaces",
    "width": 2,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".r", ".rprofile"],
  "keywords": [
    "function",
    "library",
    "require",
    "source",
    "UseMethod",
    "NextMethod"
  ],
  "controlStatements": [
    "if",
    "else",
    "repeat",
    "while",
    "for",
    "in",
    "next",
    "break",
    "return",
    "switch"
  ],
  "types": [
    "character",
    "complex",
    "double",
    "expression",
    "integer",
    "list",
    "logical",
    "numeric",
    "raw",
    "vector",
    "data.frame",
    "matrix",
    "array",
    "factor",
    "environment",
    "closure",
    "language",
    "symbol",
    "pairlist",
    "S4"
  ],
  "constants": [
    "TRUE",
    "FALSE",
    "NULL",
    "NA",
    "NA_integer_",
    "NA_real_",
    "NA_complex_",
    "NA_character_",
    "Inf",
    "NaN"
  ],
  "comments": {
    "line": "#"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "formatter": {
    "command": "R",
    "arguments": [
      "--no-echo",
      "--no-save",
      "--no-restore",
      "-e",
      "styler::style_text(readLines(file('stdin')))"
    ],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
