{
  "id": "css",
  "name": "CSS",
  "indentation": {
    "style": "spaces",
    "width": 2,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".css"],
  "keywords": [
    "charset",
    "import",
    "namespace",
    "media",
    "supports",
    "document",
    "page",
    "font-face",
    "keyframes",
    "viewport",
    "counter-style",
    "font-feature-values",
    "layer",
    "container",
    "property",
    "scope",
    "starting-style",
    "custom-media",
    "custom-selector",
    "var",
    "calc",
    "rgb",
    "rgba",
    "hsl",
    "hsla",
    "url",
    "attr",
    "env",
    "min",
    "max",
    "clamp",
    "color",
    "background",
    "display",
    "position",
    "margin",
    "padding",
    "border",
    "font",
    "width",
    "height",
    "top",
    "right",
    "bottom",
    "left",
    "flex",
    "grid",
    "gap",
    "align",
    "justify",
    "content",
    "opacity",
    "overflow",
    "transform",
    "transition",
    "animation",
    "box",
    "shadow",
    "text",
    "line",
    "letter",
    "white",
    "cursor",
    "visibility",
    "float",
    "clear",
    "object",
    "filter",
    "mask",
    "clip",
    "columns",
    "outline",
    "resize",
    "table",
    "caption",
    "vertical",
    "direction",
    "unicode",
    "writing",
    "word",
    "hyphens",
    "tab",
    "pointer",
    "user",
    "z",
    "order",
    "place",
    "inset",
    "aspect",
    "backdrop",
    "list",
    "quotes",
    "scroll",
    "overscroll",
    "touch",
    "will",
    "isolation",
    "mix",
    "appearance",
    "accent",
    "caret",
    "break",
    "widows",
    "orphans"
  ],
  "controlStatements": ["and", "or", "not", "only", "from", "to"],
  "types": [
    "px",
    "em",
    "rem",
    "ex",
    "ch",
    "vw",
    "vh",
    "vmin",
    "vmax",
    "cm",
    "mm",
    "in",
    "pt",
    "pc",
    "q",
    "deg",
    "rad",
    "grad",
    "turn",
    "s",
    "ms",
    "hz",
    "khz",
    "dpi",
    "dpcm",
    "dppx",
    "fr"
  ],
  "constants": [
    "important",
    "inherit",
    "initial",
    "unset",
    "revert",
    "revert-layer",
    "none",
    "auto",
    "normal",
    "transparent",
    "currentColor",
    "true",
    "false"
  ],
  "comments": {
    "blockStart": "/*",
    "blockEnd": "*/"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "formatter": {
    "command": "prettier",
    "arguments": ["--stdin-filepath", "{path}"],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  },
  "fallbackFormatter": {
    "command": "biome",
    "arguments": ["format", "--stdin-file-path", "{path}"],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
