{
  "id": "julia",
  "name": "Julia",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".jl"],
  "keywords": [
    "abstract",
    "baremodule",
    "begin",
    "const",
    "do",
    "end",
    "export",
    "function",
    "global",
    "import",
    "in",
    "isa",
    "let",
    "local",
    "macro",
    "module",
    "mutable",
    "new",
    "primitive",
    "quote",
    "struct",
    "type",
    "using",
    "where"
  ],
  "controlStatements": [
    "break",
    "catch",
    "continue",
    "else",
    "elseif",
    "finally",
    "for",
    "if",
    "return",
    "throw",
    "try",
    "while"
  ],
  "types": [
    "AbstractArray",
    "Any",
    "Array",
    "Bool",
    "Char",
    "Complex",
    "Dict",
    "Float16",
    "Float32",
    "Float64",
    "Function",
    "Int",
    "Int8",
    "Int16",
    "Int32",
    "Int64",
    "Int128",
    "Matrix",
    "Missing",
    "NamedTuple",
    "Nothing",
    "Number",
    "Pair",
    "Real",
    "Ref",
    "Set",
    "Signed",
    "String",
    "Symbol",
    "Tuple",
    "Type",
    "UInt",
    "UInt8",
    "UInt16",
    "UInt32",
    "UInt64",
    "UInt128",
    "Union",
    "Unsigned",
    "Vector"
  ],
  "constants": ["Inf", "NaN", "false", "missing", "nothing", "true", "π"],
  "comments": {
    "line": "#",
    "blockStart": "#=",
    "blockEnd": "=#"
  },
  "strings": {
    "quoteCharacters": ["\"", "'", "`"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": [
    "function",
    "if",
    "for",
    "while",
    "begin",
    "let",
    "struct",
    "module",
    "do"
  ],
  "unindentBefore": ["end", "else", "elseif", "catch", "finally"],
  "formatter": {
    "command": "julia",
    "arguments": [
      "--startup-file=no",
      "-e",
      "using JuliaFormatter; print(format_text(read(stdin, String)))"
    ],
    "input": "stdin",
    "output": "stdout",
    "timeout": 60000
  }
}
