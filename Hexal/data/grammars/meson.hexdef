{
  "id": "meson",
  "name": "Meson",
  "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".meson"],
  "fileNames": ["meson.build", "meson_options.txt", "meson.options"],
  "keywords": [
    "add_global_arguments",
    "add_global_link_arguments",
    "add_project_arguments",
    "add_project_link_arguments",
    "assert",
    "benchmark",
    "both_libraries",
    "build_target",
    "cmake",
    "compiler",
    "configuration_data",
    "configure_file",
    "custom_target",
    "declare_dependency",
    "dependency",
    "disabler",
    "environment",
    "error",
    "executable",
    "files",
    "find_library",
    "find_program",
    "generator",
    "get_option",
    "get_variable",
    "gnome",
    "import",
    "include_directories",
    "install_data",
    "install_headers",
    "install_man",
    "install_subdir",
    "is_disabler",
    "is_variable",
    "jar",
    "join_paths",
    "library",
    "message",
    "pkgconfig",
    "project",
    "range",
    "run_command",
    "run_target",
    "set_variable",
    "shared_library",
    "shared_module",
    "static_library",
    "subdir",
    "subproject",
    "summary",
    "test",
    "unset_variable",
    "vcs_tag",
    "warning"
  ],
  "controlStatements": [
    "break",
    "continue",
    "elif",
    "else",
    "endforeach",
    "endif",
    "endforeach",
    "if",
    "foreach"
  ],
  "types": ["boolean", "integer", "string"],
  "constants": ["false", "true"],
  "comments": {
    "line": "#"
  },
  "strings": {
    "quoteCharacters": ["'''", "'", "\""],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["if", "foreach"],
  "formatter": {
    "command": "meson",
    "arguments": [
      "format",
      "--source-file-path",
      "{path}",
      "-"
    ],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
