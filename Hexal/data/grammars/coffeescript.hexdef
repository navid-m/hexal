{
  "id": "coffeescript",
  "name": "CoffeeScript",
  "indentation": {
    "style": "spaces",
    "width": 2,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".coffee", ".litcoffee", ".coffee.md"],
  "keywords": [
    "as",
    "async",
    "await",
    "by",
    "class",
    "default",
    "delete",
    "do",
    "extends",
    "from",
    "function",
    "import",
    "in",
    "instanceof",
    "is",
    "isnt",
    "loop",
    "new",
    "not",
    "of",
    "return",
    "super",
    "this",
    "throw",
    "typeof",
    "unless",
    "until",
    "yield"
  ],
  "controlStatements": [
    "break",
    "catch",
    "continue",
    "else",
    "finally",
    "for",
    "if",
    "loop",
    "return",
    "switch",
    "then",
    "throw",
    "try",
    "unless",
    "until",
    "when",
    "while"
  ],
  "types": [],
  "constants": ["false", "no", "null", "off", "on", "true", "undefined", "yes"],
  "comments": {
    "line": "#",
    "blockStart": "###",
    "blockEnd": "###"
  },
  "strings": {
    "quoteCharacters": ["\"\"\"", "'''", "\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": [
    "->",
    "=>",
    "catch",
    "class",
    "do",
    "else",
    "finally",
    "for",
    "if",
    "switch",
    "then",
    "try",
    "unless",
    "until",
    "while"
  ],
  "unindentBefore": ["catch", "else", "finally", "when"]
}
