{
  "id": "matlab",
  "name": "MATLAB",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".m"],
  "keywords": [
    "arguments",
    "classdef",
    "enumeration",
    "events",
    "function",
    "global",
    "import",
    "methods",
    "onCleanup",
    "parfor",
    "persistent",
    "properties",
    "spmd",
    "try",
    "catch",
    "switch",
    "case",
    "otherwise",
    "if",
    "elseif",
    "else",
    "while",
    "for",
    "break",
    "continue",
    "return",
    "end",
    "plot",
    "disp",
    "fprintf",
    "sprintf",
    "size",
    "length",
    "numel",
    "zeros",
    "ones",
    "eye",
    "linspace",
    "reshape",
    "transpose",
    "inv",
    "det",
    "eig",
    "svd",
    "norm",
    "abs",
    "sqrt",
    "exp",
    "log",
    "sin",
    "cos",
    "tan",
    "max",
    "min",
    "sum",
    "mean",
    "median",
    "std",
    "var",
    "sort",
    "find",
    "isempty"
  ],
  "controlStatements": [
    "break",
    "case",
    "catch",
    "continue",
    "else",
    "elseif",
    "end",
    "for",
    "if",
    "otherwise",
    "parfor",
    "return",
    "spmd",
    "switch",
    "try",
    "while"
  ],
  "types": [
    "cell",
    "char",
    "categorical",
    "datetime",
    "double",
    "duration",
    "function_handle",
    "int8",
    "int16",
    "int32",
    "int64",
    "logical",
    "single",
    "string",
    "struct",
    "table",
    "timetable",
    "uint8",
    "uint16",
    "uint32",
    "uint64"
  ],
  "constants": ["Inf", "NaN", "eps", "false", "i", "j", "pi", "true"],
  "comments": {
    "line": "%",
    "blockStart": "%{",
    "blockEnd": "%}"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"]
  },
  "numbers": true,
  "indentAfter": ["function", "if", "for", "while", "switch", "try", "parfor"],
  "unindentBefore": ["end", "else", "elseif", "catch", "case", "otherwise"]
}
