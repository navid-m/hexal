{
  "id": "toml",
  "name": "TOML",
  "indentation": {
    "style": "spaces",
    "width": 4,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".toml"],
  "keywords": [],
  "controlStatements": [],
  "types": [],
  "constants": ["true", "false", "inf", "nan"],
  "comments": {
    "line": "#"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "formatter": {
    "command": "taplo",
    "arguments": ["fmt", "-"],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
