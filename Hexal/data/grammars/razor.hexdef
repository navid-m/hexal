{
  "id": "razor",
  "name": "Razor",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "traditionalMarkupLanguage": true,
  "extensions": [".cshtml", ".razor", ".vbhtml"],
  "keywords": [
    "addTagHelper",
    "attribute",
    "base",
    "bind",
    "class",
    "code",
    "delegate",
    "enum",
    "event",
    "explicit",
    "extern",
    "fixed",
    "functions",
    "implements",
    "implicit",
    "inherits",
    "inject",
    "interface",
    "internal",
    "is",
    "layout",
    "lock",
    "model",
    "namespace",
    "new",
    "operator",
    "out",
    "override",
    "page",
    "params",
    "partial",
    "preservewhitespace",
    "private",
    "protected",
    "public",
    "readonly",
    "record",
    "ref",
    "removeTagHelper",
    "rendermode",
    "sealed",
    "section",
    "sizeof",
    "stackalloc",
    "static",
    "struct",
    "tagHelperPrefix",
    "this",
    "typeparam",
    "typeof",
    "unsafe",
    "using",
    "virtual",
    "volatile",
    "where",
    "a",
    "abbr",
    "address",
    "article",
    "aside",
    "audio",
    "b",
    "blockquote",
    "body",
    "br",
    "button",
    "canvas",
    "caption",
    "code",
    "col",
    "colgroup",
    "dd",
    "del",
    "details",
    "dialog",
    "div",
    "dl",
    "dt",
    "em",
    "embed",
    "fieldset",
    "figcaption",
    "figure",
    "footer",
    "form",
    "h1",
    "h2",
    "h3",
    "h4",
    "h5",
    "h6",
    "head",
    "header",
    "hr",
    "html",
    "i",
    "iframe",
    "img",
    "input",
    "label",
    "legend",
    "li",
    "link",
    "main",
    "meta",
    "nav",
    "object",
    "ol",
    "optgroup",
    "option",
    "output",
    "p",
    "picture",
    "pre",
    "progress",
    "q",
    "script",
    "section",
    "select",
    "small",
    "source",
    "span",
    "strong",
    "style",
    "summary",
    "svg",
    "table",
    "tbody",
    "td",
    "template",
    "textarea",
    "tfoot",
    "th",
    "thead",
    "time",
    "title",
    "tr",
    "u",
    "ul",
    "video"
  ],
  "controlStatements": [
    "break",
    "case",
    "catch",
    "continue",
    "default",
    "do",
    "else",
    "finally",
    "for",
    "foreach",
    "goto",
    "if",
    "return",
    "switch",
    "throw",
    "try",
    "while",
    "yield"
  ],
  "types": [
    "bool",
    "byte",
    "char",
    "decimal",
    "double",
    "dynamic",
    "float",
    "int",
    "long",
    "nint",
    "nuint",
    "object",
    "sbyte",
    "short",
    "string",
    "uint",
    "ulong",
    "ushort",
    "var",
    "void",
    "accept",
    "action",
    "alt",
    "async",
    "autocomplete",
    "autofocus",
    "autoplay",
    "checked",
    "class",
    "cols",
    "colspan",
    "content",
    "controls",
    "datetime",
    "defer",
    "disabled",
    "download",
    "for",
    "form",
    "headers",
    "height",
    "hidden",
    "href",
    "id",
    "integrity",
    "label",
    "lang",
    "list",
    "loop",
    "max",
    "maxlength",
    "media",
    "method",
    "min",
    "minlength",
    "multiple",
    "muted",
    "name",
    "open",
    "pattern",
    "placeholder",
    "readonly",
    "rel",
    "required",
    "role",
    "rows",
    "rowspan",
    "selected",
    "size",
    "src",
    "srcset",
    "step",
    "style",
    "tabindex",
    "target",
    "title",
    "type",
    "value",
    "width",
    "wrap"
  ],
  "constants": ["true", "false", "null"],
  "comments": {
    "blockStart": "@*",
    "blockEnd": "*@"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true
}
