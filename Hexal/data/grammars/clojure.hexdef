{
  "id": "clojure",
  "name": "Clojure",
  "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".clj", ".cljs", ".cljc", ".edn"],
  "keywords": [
    "def",
    "defn",
    "defn-",
    "defmacro",
    "defmulti",
    "defmethod",
    "defprotocol",
    "defrecord",
    "deftype",
    "definterface",
    "defstruct",
    "declare",
    "ns",
    "import",
    "require",
    "use",
    "refer",
    "gen-class",
    "gen-interface",
    "let",
    "letfn",
    "binding",
    "loop",
    "recur",
    "fn",
    "if",
    "if-let",
    "if-not",
    "if-some",
    "when",
    "when-let",
    "when-not",
    "when-some",
    "cond",
    "condp",
    "case",
    "do",
    "doseq",
    "dotimes",
    "for",
    "lazy-seq",
    "try",
    "catch",
    "finally",
    "throw",
    "new",
    "set!",
    "quote",
    "var",
    "with-open",
    "with-out-str",
    "with-in-str",
    "with-redefs",
    "locking",
    "monitor-enter",
    "monitor-exit",
    "proxy",
    "reify",
    "deftest",
    "testing",
    "is",
    "are"
  ],
  "controlStatements": [
    "if",
    "if-let",
    "if-not",
    "if-some",
    "when",
    "when-let",
    "when-not",
    "when-some",
    "cond",
    "condp",
    "case",
    "do",
    "doseq",
    "dotimes",
    "for",
    "loop",
    "recur",
    "try",
    "catch",
    "finally",
    "throw",
    "return"
  ],
  "types": [
    "Agent",
    "ArrayMap",
    "Atom",
    "BigDecimal",
    "BigInt",
    "Boolean",
    "Character",
    "Delay",
    "Double",
    "File",
    "Float",
    "Future",
    "HashMap",
    "Integer",
    "Keyword",
    "LazySeq",
    "List",
    "Long",
    "Map",
    "MapEntry",
    "Namespace",
    "PersistentArrayMap",
    "PersistentHashMap",
    "PersistentHashSet",
    "PersistentList",
    "PersistentQueue",
    "PersistentVector",
    "Ratio",
    "Record",
    "Ref",
    "Seq",
    "Set",
    "String",
    "Symbol",
    "Var",
    "Vector"
  ],
  "constants": ["true", "false", "nil"],
  "comments": {
    "line": ";"
  },
  "strings": {
    "quoteCharacters": ["\""],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["(", "[", "{"],
  "unindentBefore": [")", "]", "}"]
}
