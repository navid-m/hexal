{
  "id": "tcl",
  "name": "Tcl",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [
    ".tcl",
    ".tk",
    ".itcl",
    ".tm",
    ".irul",
    ".irule",
    ".iapp",
    ".iappimpl",
    ".impl",
    ".exp"
  ],
  "keywords": [
    "append",
    "array",
    "binary",
    "bind",
    "channel",
    "clock",
    "close",
    "concat",
    "continue",
    "dict",
    "encoding",
    "eof",
    "error",
    "eval",
    "exec",
    "exit",
    "expr",
    "fblocked",
    "fconfigure",
    "file",
    "flush",
    "format",
    "gets",
    "glob",
    "global",
    "history",
    "incr",
    "info",
    "interp",
    "join",
    "lappend",
    "lassign",
    "lindex",
    "linsert",
    "list",
    "llength",
    "lmap",
    "lrange",
    "lrepeat",
    "lreplace",
    "lreverse",
    "lsearch",
    "lset",
    "lsort",
    "namespace",
    "open",
    "package",
    "pid",
    "proc",
    "puts",
    "pwd",
    "read",
    "regexp",
    "regsub",
    "rename",
    "return",
    "scan",
    "seek",
    "set",
    "socket",
    "source",
    "split",
    "string",
    "subst",
    "switch",
    "tell",
    "time",
    "trace",
    "unknown",
    "unload",
    "unset",
    "update",
    "uplevel",
    "upvar",
    "variable",
    "vwait",
    "after",
    "bell",
    "bind",
    "bindtags",
    "button",
    "canvas",
    "checkbutton",
    "clipboard",
    "destroy",
    "entry",
    "event",
    "focus",
    "font",
    "frame",
    "grab",
    "grid",
    "image",
    "label",
    "listbox",
    "lower",
    "menu",
    "menubutton",
    "message",
    "option",
    "pack",
    "panedwindow",
    "place",
    "radiobutton",
    "raise",
    "scale",
    "scrollbar",
    "selection",
    "spinbox",
    "text",
    "tk",
    "toplevel",
    "winfo",
    "wm",
    "oo::class",
    "oo::object",
    "oo::copy",
    "oo::define",
    "oo::objdefine",
    "my",
    "self",
    "next",
    "constructor",
    "destructor",
    "method",
    "superclass",
    "mixin"
  ],
  "controlStatements": [
    "if",
    "then",
    "else",
    "elseif",
    "while",
    "for",
    "foreach",
    "switch",
    "case",
    "default",
    "break",
    "continue",
    "return",
    "catch",
    "try",
    "finally",
    "throw",
    "proc",
    "namespace",
    "eval",
    "uplevel",
    "upvar",
    "global",
    "variable",
    "source",
    "package",
    "error"
  ],
  "types": ["string", "int", "double", "boolean", "list", "dict", "array"],
  "constants": ["true", "false", "yes", "no", "on", "off", "nil", "null"],
  "comments": {
    "line": "#"
  },
  "strings": {
    "quoteCharacters": ["\""],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["{", "["],
  "unindentBefore": ["}", "]"]
}
