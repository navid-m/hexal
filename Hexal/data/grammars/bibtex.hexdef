{
  "id": "bibtex",
  "name": "BibTeX",
  "indentation": {
    "style": "spaces",
    "width": 2,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".bib"],
  "keywords": [
    "article",
    "book",
    "booklet",
    "comment",
    "conference",
    "inbook",
    "incollection",
    "inproceedings",
    "manual",
    "mastersthesis",
    "misc",
    "phdthesis",
    "preamble",
    "proceedings",
    "string",
    "techreport",
    "unpublished"
  ],
  "controlStatements": ["comment", "preamble", "string"],
  "types": [
    "abstract",
    "address",
    "annote",
    "archiveprefix",
    "author",
    "booktitle",
    "chapter",
    "day",
    "doi",
    "edition",
    "editor",
    "eprint",
    "file",
    "howpublished",
    "institution",
    "isbn",
    "issn",
    "journal",
    "keywords",
    "month",
    "note",
    "number",
    "organization",
    "pages",
    "publisher",
    "school",
    "series",
    "title",
    "type",
    "url",
    "volume",
    "year"
  ],
  "constants": [
    "apr",
    "aug",
    "dec",
    "feb",
    "false",
    "jan",
    "jul",
    "jun",
    "mar",
    "may",
    "nov",
    "oct",
    "sep",
    "true"
  ],
  "comments": {
    "line": "%"
  },
  "strings": {
    "quoteCharacters": ["\""],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["{"],
  "unindentBefore": ["}"],
  "formatter": {
    "command": "bibtex-tidy",
    "arguments": [
      "-",
      "--quiet"
    ],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
