{
  "id": "asciidoc",
  "name": "AsciiDoc",
  "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
  "autoIndent": false,
  "autoClose": false,
  "extensions": [".adoc", ".asciidoc", ".asc"],
  "keywords": [],
  "controlStatements": [],
  "types": [],
  "constants": [],
  "comments": {
    "line": "//",
    "blockStart": "////",
    "blockEnd": "////"
  },
  "numbers": false
}
