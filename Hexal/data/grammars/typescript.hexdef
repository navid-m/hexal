{
  "id": "typescript",
  "name": "TypeScript",
  "indentation": {
    "style": "spaces",
    "width": 2,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".ts", ".mts", ".cts"],
  "keywords": [
    "abstract",
    "accessor",
    "as",
    "asserts",
    "async",
    "await",
    "class",
    "const",
    "constructor",
    "debugger",
    "declare",
    "delete",
    "enum",
    "export",
    "extends",
    "from",
    "function",
    "get",
    "implements",
    "import",
    "in",
    "infer",
    "instanceof",
    "interface",
    "is",
    "keyof",
    "let",
    "module",
    "namespace",
    "new",
    "of",
    "override",
    "private",
    "protected",
    "public",
    "readonly",
    "require",
    "satisfies",
    "set",
    "static",
    "super",
    "symbol",
    "this",
    "type",
    "typeof",
    "unique",
    "unknown",
    "var",
    "void",
    "with"
  ],
  "controlStatements": [
    "break",
    "case",
    "catch",
    "continue",
    "default",
    "do",
    "else",
    "finally",
    "for",
    "if",
    "return",
    "switch",
    "throw",
    "try",
    "while",
    "yield"
  ],
  "types": [
    "any",
    "bigint",
    "boolean",
    "never",
    "number",
    "object",
    "string",
    "symbol",
    "undefined",
    "unknown",
    "void",
    "Array",
    "ReadonlyArray",
    "Record",
    "Partial",
    "Required",
    "Readonly",
    "Pick",
    "Omit",
    "Exclude",
    "Extract",
    "NonNullable",
    "Parameters",
    "ReturnType",
    "InstanceType",
    "Awaited",
    "Promise",
    "Map",
    "Set",
    "WeakMap",
    "WeakSet",
    "Date",
    "RegExp",
    "Error",
    "Function",
    "Object",
    "String",
    "Number",
    "Boolean",
    "BigInt",
    "Symbol",
    "Iterable",
    "Iterator",
    "AsyncIterable",
    "Generator",
    "AsyncGenerator"
  ],
  "constants": ["true", "false", "null", "undefined", "NaN", "Infinity"],
  "comments": {
    "line": "//",
    "blockStart": "/*",
    "blockEnd": "*/"
  },
  "strings": {
    "quoteCharacters": ["\"", "'", "`"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "formatter": {
    "command": "prettier",
    "arguments": ["--stdin-filepath", "{path}"],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  },
  "fallbackFormatter": {
    "command": "biome",
    "arguments": ["format", "--stdin-file-path", "{path}"],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  },
  "debugger": {
    "adapter": "js-debug-adapter",
    "arguments": [],
    "configuration": {
      "type": "node",
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspace}"
    }
  }
}
