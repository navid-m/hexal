{
  "id": "xml",
  "name": "XML",
  "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "traditionalMarkupLanguage": true,
  "extensions": [".xml", ".csproj", ".rpp", ".props"],
  "keywords": [
    "xml",
    "version",
    "encoding",
    "standalone",
    "xmlns",
    "xsi",
    "schemaLocation",
    "noNamespaceSchemaLocation"
  ],
  "controlStatements": [],
  "types": [],
  "constants": ["true", "false"],
  "comments": {
    "blockStart": "<!--",
    "blockEnd": "-->"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"]
  },
  "numbers": true,
  "formatter": {
    "command": "xmllint",
    "arguments": [
      "--format",
      "-"
    ],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  },
  "fallbackFormatter": {
    "command": "xmlformat",
    "arguments": [
      "-"
    ],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
