{
  "id": "scala",
  "name": "Scala",
  "indentation": {
    "style": "spaces",
    "width": 2,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".scala", ".sc", ".sbt"],
  "keywords": [
    "abstract",
    "alias",
    "class",
    "def",
    "derives",
    "enum",
    "export",
    "extends",
    "extension",
    "final",
    "forSome",
    "given",
    "implicit",
    "import",
    "lazy",
    "new",
    "object",
    "opaque",
    "open",
    "override",
    "package",
    "private",
    "protected",
    "sealed",
    "super",
    "this",
    "trait",
    "transparent",
    "type",
    "val",
    "var",
    "with",
    "using",
    "inline",
    "throws",
    "end"
  ],
  "controlStatements": [
    "case",
    "catch",
    "do",
    "else",
    "finally",
    "for",
    "if",
    "match",
    "return",
    "then",
    "throw",
    "try",
    "while",
    "yield"
  ],
  "types": [
    "Any",
    "AnyRef",
    "AnyVal",
    "Boolean",
    "Byte",
    "Char",
    "Double",
    "Float",
    "Int",
    "Long",
    "Nothing",
    "Null",
    "Short",
    "String",
    "Unit",
    "Array",
    "List",
    "Vector",
    "Seq",
    "Set",
    "Map",
    "Option",
    "Some",
    "None",
    "Either",
    "Left",
    "Right",
    "Future",
    "Promise",
    "Try",
    "Success",
    "Failure",
    "Iterable",
    "Iterator",
    "Tuple",
    "BigInt",
    "BigDecimal",
    "Function",
    "PartialFunction",
    "Ordering"
  ],
  "constants": ["true", "false", "null", "Nil"],
  "comments": {
    "line": "//",
    "blockStart": "/*",
    "blockEnd": "*/"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "formatter": {
    "command": "scalafmt",
    "arguments": [
      "--stdin"
    ],
    "input": "stdin",
    "output": "stdout",
    "timeout": 30000
  }
}
