{
  "id": "kotlin",
  "name": "Kotlin",
  "indentation": {
    "style": "spaces",
    "width": 4,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".kt", ".kts"],
  "keywords": [
    "abstract",
    "actual",
    "annotation",
    "as",
    "by",
    "class",
    "companion",
    "const",
    "constructor",
    "crossinline",
    "data",
    "delegate",
    "dynamic",
    "enum",
    "expect",
    "external",
    "field",
    "file",
    "final",
    "fun",
    "get",
    "implements",
    "import",
    "in",
    "infix",
    "init",
    "inline",
    "inner",
    "interface",
    "internal",
    "is",
    "lateinit",
    "noinline",
    "object",
    "open",
    "operator",
    "out",
    "override",
    "package",
    "param",
    "private",
    "property",
    "protected",
    "public",
    "receiver",
    "reified",
    "sealed",
    "set",
    "setparam",
    "static",
    "super",
    "suspend",
    "tailrec",
    "this",
    "typealias",
    "typeof",
    "val",
    "value",
    "var",
    "vararg",
    "where"
  ],
  "controlStatements": [
    "break",
    "catch",
    "continue",
    "do",
    "else",
    "finally",
    "for",
    "if",
    "return",
    "throw",
    "try",
    "when",
    "while"
  ],
  "types": [
    "Any",
    "Boolean",
    "Byte",
    "Char",
    "Double",
    "Float",
    "Int",
    "Long",
    "Nothing",
    "Short",
    "String",
    "Unit",
    "Array",
    "BooleanArray",
    "ByteArray",
    "CharArray",
    "DoubleArray",
    "FloatArray",
    "IntArray",
    "LongArray",
    "ShortArray",
    "List",
    "MutableList",
    "Map",
    "MutableMap",
    "Set",
    "MutableSet",
    "Collection",
    "Iterable",
    "Iterator",
    "Sequence",
    "Pair",
    "Triple",
    "Result",
    "Comparable",
    "Runnable",
    "Throwable",
    "Exception"
  ],
  "constants": ["true", "false", "null"],
  "comments": {
    "line": "//",
    "blockStart": "/*",
    "blockEnd": "*/"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "formatter": {
    "command": "ktlint",
    "arguments": ["--log-level=none", "--stdin", "-F", "-"],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  },
  "debugger": {
    "adapter": "kotlin-debug-adapter",
    "configuration": {
      "type": "kotlin",
      "request": "launch",
      "projectRoot": "${workspace}",
      "mainClass": "${fileBasenameNoExtension}Kt",
      "stopOnEntry": false
    }
  }
}
