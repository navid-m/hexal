{
  "id": "awk",
  "name": "AWK",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".awk", ".gawk"],
  "keywords": [
    "BEGIN",
    "END",
    "BEGINFILE",
    "ENDFILE",
    "function",
    "func",
    "getline",
    "next",
    "nextfile",
    "delete",
    "in",
    "print",
    "printf",
    "length",
    "substr",
    "index",
    "split",
    "sub",
    "gsub",
    "match",
    "sprintf",
    "sin",
    "cos",
    "atan2",
    "exp",
    "log",
    "sqrt",
    "int",
    "rand",
    "srand",
    "tolower",
    "toupper",
    "system",
    "close",
    "fflush",
    "gensub",
    "patsplit",
    "strtonum",
    "and",
    "or",
    "xor",
    "compl",
    "lshift",
    "rshift",
    "mktime",
    "strftime",
    "systime"
  ],
  "controlStatements": [
    "if",
    "else",
    "while",
    "do",
    "for",
    "break",
    "continue",
    "return",
    "exit",
    "switch",
    "case",
    "default"
  ],
  "types": [],
  "constants": [
    "FS",
    "OFS",
    "RS",
    "ORS",
    "NF",
    "NR",
    "FNR",
    "FILENAME",
    "ARGC",
    "ARGV",
    "ENVIRON",
    "PROCINFO",
    "RSTART",
    "RLENGTH",
    "SUBSEP",
    "CONVFMT",
    "OFMT",
    "RT"
  ],
  "comments": {
    "line": "#"
  },
  "strings": {
    "quoteCharacters": ["\""],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["{"],
  "unindentBefore": ["}"]
}
