{
  "id": "spectre",
  "name": "Spectre",
  "indentation": {
    "style": "spaces",
    "width": 4,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".sx"],
  "keywords": [
    "as",
    "assert",
    "enum",
    "err",
    "extern",
    "fn",
    "guarded",
    "invariant",
    "is",
    "link",
    "mut",
    "none",
    "ok",
    "or",
    "post",
    "pre",
    "pub",
    "ref",
    "self",
    "some",
    "spec",
    "test",
    "trust",
    "type",
    "union",
    "use",
    "val"
  ],
  "controlStatements": [
    "break",
    "continue",
    "defer",
    "elif",
    "else",
    "for",
    "guard",
    "if",
    "in",
    "match",
    "return",
    "when"
  ],
  "types": [
    "bool",
    "char",
    "f32",
    "f64",
    "i8",
    "i16",
    "i32",
    "i64",
    "isize",
    "u8",
    "u16",
    "u32",
    "u64",
    "usize",
    "void",
    "option",
    "result",
    "list",
    "array",
    "ref",
    "mut"
  ],
  "constants": ["true", "false"],
  "comments": {
    "line": "//",
    "blockStart": "/*",
    "blockEnd": "*/"
  },
  "strings": {
    "quoteCharacters": ["\""],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["=>"],
  "unindentBefore": ["}", "else", "elif"]
}
