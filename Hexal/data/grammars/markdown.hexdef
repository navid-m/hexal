{
  "id": "markdown",
  "name": "Markdown",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
  "autoIndent": false,
  "autoClose": false,
  "extensions": [".md", ".markdown", ".mdown", ".mkd", ".mkdn"],
  "keywords": [],
  "controlStatements": [],
  "types": [],
  "constants": [],
  "comments": {
    "blockStart": "<!--",
    "blockEnd": "-->"
  },
  "numbers": false,
  "formatter": {
    "command": "prettier",
    "arguments": [
      "--stdin-filepath",
      "{path}"
    ],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  },
  "fallbackFormatter": {
    "command": "mdformat",
    "arguments": [
      "-"
    ],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
