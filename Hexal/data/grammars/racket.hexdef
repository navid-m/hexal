{
  "id": "racket",
  "name": "Racket",
  "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".rkt", ".rktl", ".rktd", ".scrbl"],
  "keywords": [
    "define",
    "define-values",
    "define-syntax",
    "define-syntax-rule",
    "define/contract",
    "define/struct",
    "lambda",
    "let",
    "let*",
    "letrec",
    "let-values",
    "let*-values",
    "letrec-values",
    "set!",
    "if",
    "cond",
    "else",
    "case",
    "when",
    "unless",
    "begin",
    "begin0",
    "for",
    "for/list",
    "for/vector",
    "for/hash",
    "for/fold",
    "for-each",
    "match",
    "struct",
    "require",
    "provide",
    "module",
    "module+",
    "module*",
    "quote",
    "quasiquote",
    "unquote",
    "unquote-splicing",
    "and",
    "or",
    "not",
    "list",
    "cons",
    "car",
    "cdr",
    "map",
    "filter",
    "foldl",
    "foldr",
    "apply",
    "call/cc",
    "call-with-values",
    "values",
    "dynamic-wind",
    "with-handlers",
    "raise",
    "error",
    "printf",
    "displayln",
    "display",
    "newline",
    "string-append",
    "string-length",
    "substring",
    "format",
    "hash",
    "hash-ref",
    "hash-set!",
    "hash-remove!",
    "vector",
    "vector-ref",
    "vector-set!",
    "make-vector",
    "current-output-port",
    "current-input-port",
    "parameterize",
    "syntax-rules",
    "syntax-case",
    "let-syntax",
    "letrec-syntax",
    "contract-out",
    "->",
    "->*",
    ":",
    "send",
    "new",
    "instantiate",
    "class",
    "interface",
    "init",
    "field",
    "public",
    "private",
    "override",
    "super-new",
    "rename-out",
    "except-in",
    "only-in",
    "prefix-in"
  ],
  "controlStatements": [
    "if",
    "cond",
    "case",
    "when",
    "unless",
    "begin",
    "begin0",
    "for",
    "for/list",
    "for-each",
    "match",
    "lambda",
    "let",
    "let*",
    "letrec",
    "set!",
    "and",
    "or",
    "not"
  ],
  "types": [
    "Integer",
    "Real",
    "Number",
    "String",
    "Symbol",
    "Boolean",
    "Listof",
    "Vectorof",
    "Any",
    "Void",
    "Char",
    "Bytes",
    "Path",
    "Hash",
    "Procedure",
    "Struct",
    "Port"
  ],
  "constants": ["#t", "#f", "null", "empty", "eof", "true", "false"],
  "comments": {
    "line": ";",
    "blockStart": "#|",
    "blockEnd": "|#"
  },
  "strings": {
    "quoteCharacters": ["\""],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["(", "["],
  "unindentBefore": [")", "]"],
  "formatter": {
    "command": "raco",
    "arguments": [
      "fmt"
    ],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
