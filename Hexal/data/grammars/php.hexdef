{
  "id": "php",
  "name": "PHP",
  "indentation": {
    "style": "spaces",
    "width": 4,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [
    ".php",
    ".php3",
    ".php4",
    ".php5",
    ".php7",
    ".php8",
    ".phtml",
    ".phps",
    ".ctp"
  ],
  "keywords": [
    "abstract",
    "and",
    "array",
    "as",
    "callable",
    "class",
    "clone",
    "const",
    "declare",
    "echo",
    "empty",
    "enddeclare",
    "endfor",
    "endforeach",
    "endif",
    "endswitch",
    "endwhile",
    "enum",
    "eval",
    "exit",
    "extends",
    "final",
    "fn",
    "function",
    "global",
    "goto",
    "implements",
    "include",
    "include_once",
    "instanceof",
    "insteadof",
    "interface",
    "isset",
    "list",
    "namespace",
    "new",
    "or",
    "print",
    "private",
    "protected",
    "public",
    "readonly",
    "require",
    "require_once",
    "static",
    "trait",
    "unset",
    "use",
    "var",
    "xor"
  ],
  "controlStatements": [
    "break",
    "case",
    "catch",
    "continue",
    "default",
    "do",
    "else",
    "elseif",
    "finally",
    "for",
    "foreach",
    "if",
    "match",
    "return",
    "switch",
    "throw",
    "try",
    "while",
    "yield"
  ],
  "types": [
    "bool",
    "boolean",
    "int",
    "integer",
    "float",
    "double",
    "string",
    "array",
    "object",
    "callable",
    "iterable",
    "mixed",
    "void",
    "never",
    "self",
    "parent",
    "static",
    "resource",
    "Closure",
    "Generator",
    "Traversable",
    "Iterator",
    "ArrayAccess",
    "Countable",
    "Stringable",
    "Throwable",
    "Exception",
    "Error"
  ],
  "constants": [
    "true",
    "false",
    "null",
    "TRUE",
    "FALSE",
    "NULL",
    "PHP_EOL",
    "PHP_INT_MAX",
    "PHP_INT_MIN",
    "PHP_VERSION",
    "DIRECTORY_SEPARATOR"
  ],
  "comments": {
    "line": "//",
    "blockStart": "/*",
    "blockEnd": "*/"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "formatter": {
    "command": "php-cs-fixer",
    "arguments": [
      "fix",
      "--using-cache=no",
      "--quiet",
      "{tmp}"
    ],
    "input": "file",
    "output": "file",
    "timeout": 30000
  },
  "debugger": {
    "adapter": "php-debug-adapter",
    "configuration": {
      "request": "launch",
      "program": "${file}",
      "cwd": "${workspace}",
      "port": 0
    }
  }
}
