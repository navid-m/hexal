{
  "id": "blood",
  "name": "Blood",
  "indentation": {
    "style": "spaces",
    "width": 4,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".bx", ".blood"],
  "fileNames": [".bloodrc"],
  "keywords": [
    "abs",
    "alias",
    "var",
    "and",
    "append_file",
    "capture",
    "cd",
    "chr",
    "clear",
    "clock",
    "cls",
    "echo",
    "env",
    "exit",
    "export",
    "fn",
    "glob",
    "help",
    "history",
    "input",
    "items",
    "jobs",
    "keys",
    "len",
    "max",
    "min",
    "not",
    "or",
    "ord",
    "para",
    "print",
    "pwd",
    "quit",
    "range",
    "read_file",
    "rename",
    "set",
    "shell",
    "sleep",
    "source",
    "str",
    "sum",
    "this",
    "this_dir",
    "time",
    "type",
    "unalias",
    "unset",
    "values",
    "wait",
    "which",
    "write_file"
  ],
  "controlStatements": [
    "break",
    "catch",
    "continue",
    "elif",
    "else",
    "except",
    "for",
    "if",
    "in",
    "pass",
    "raise",
    "return",
    "say",
    "throw",
    "try",
    "while",
    "defer"
  ],
  "types": [
    "bool",
    "dict",
    "float",
    "function",
    "int",
    "list",
    "string"
  ],
  "constants": [
    "true",
    "false",
    "null",
    "none",
    "status",
    "args",
    "__file__"
  ],
  "comments": {
    "line": "#"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["{", ":"],
  "unindentBefore": ["}", "]", ")", "elif", "else", "catch", "except"]
}
