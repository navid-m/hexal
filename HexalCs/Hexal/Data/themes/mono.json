{
    "id": "mono",
    "name": "Mono",
    "description": "Minimal grayscale theme for distraction-free editing.",
    "colors": {
        "foreground": "#e6e6e6",
        "background": "#111111",
        "muted": "#6e6e6e",
        "dimmed": "#909090",
        "accent": "#c8c8c8",
        "border": "#3a3a3a",
        "error": "#ffffff",
        "warning": "#c8c8c8",
        "success": "#a8a8a8",
        "alert": { "fg": "#111111", "bg": "#e6e6e6" },
        "selection": { "fg": "#111111", "bg": "#bfbfbf" },
        "status": { "fg": "#111111", "bg": "#c8c8c8" },
        "insert": { "fg": "#111111", "bg": "#d8d8d8" },
        "select": { "fg": "#111111", "bg": "#b0b0b0" },
        "prompt": { "fg": "#111111", "bg": "#d8d8d8" },
        "command": { "fg": "#111111", "bg": "#d8d8d8" },
        "match": { "fg": "#111111", "bg": "#b0b0b0" },
        "currentMatch": { "fg": "#111111", "bg": "#d8d8d8" },
        "syntax": {
            "keyword": "#ffffff",
            "control": "#d0d0d0",
            "type": "#e6e6e6",
            "constant": "#b8b8b8",
            "string": "#a8a8a8",
            "comment": "#707070",
            "number": "#c0c0c0"
        }
    }
}
