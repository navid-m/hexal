{
    "id": "scheme",
    "name": "Scheme",
    "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [".scm", ".ss", ".sls", ".sld", ".rkt"],
    "keywords": [
        "and", "apply", "begin", "call-with-current-continuation",
        "call-with-values", "call/cc", "case", "cond", "define",
        "define-library", "define-record-type", "define-syntax", "delay",
        "do", "dynamic-wind", "else", "eval", "export", "for-each", "force",
        "guard", "if", "import", "include", "include-ci", "lambda", "let",
        "let*", "let-values", "letrec", "letrec-syntax", "let-syntax",
        "library", "make-promise", "map", "not", "or", "parameterize",
        "quasiquote", "quote", "raise", "set!", "syntax-case",
        "syntax-rules", "unquote", "unquote-splicing", "values",
        "with-exception-handler"
    ],
    "controlStatements": [
        "and", "begin", "case", "cond", "do", "else", "guard", "if",
        "lambda", "let", "let*", "let-values", "letrec", "not", "or"
    ],
    "types": [],
    "constants": ["false", "nil", "true"],
    "comments": {
        "line": ";",
        "blockStart": "#|",
        "blockEnd": "|#"
    },
    "strings": {
        "quoteCharacters": ["\""],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "indentAfter": ["(", "["],
    "unindentBefore": [")", "]"]
}
