{
  "id": "vala",
  "name": "Vala",
  "indentation": {
    "style": "spaces",
    "width": 4,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".vala", ".vapi"],
  "keywords": [
    "abstract",
    "const",
    "delegate",
    "dynamic",
    "ensures",
    "extern",
    "inline",
    "internal",
    "override",
    "owned",
    "private",
    "protected",
    "public",
    "ref",
    "requires",
    "signal",
    "static",
    "throws",
    "unowned",
    "var",
    "virtual",
    "volatile",
    "weak",
    "namespace",
    "using",
    "class",
    "errordomain",
    "interface",
    "struct",
    "as",
    "base",
    "construct",
    "delete",
    "enum",
    "get",
    "in",
    "is",
    "new",
    "out",
    "params",
    "set",
    "sizeof",
    "this",
    "typeof"
  ],
  "controlStatements": [
    "break",
    "case",
    "catch",
    "continue",
    "default",
    "do",
    "else",
    "finally",
    "for",
    "foreach",
    "if",
    "lock",
    "return",
    "switch",
    "throw",
    "try",
    "while",
    "yield"
  ],
  "types": [
    "void",
    "bool",
    "char",
    "double",
    "float",
    "int",
    "int8",
    "int16",
    "int32",
    "int64",
    "long",
    "short",
    "size_t",
    "ssize_t",
    "string",
    "time_t",
    "uchar",
    "uint",
    "uint8",
    "uint16",
    "uint32",
    "uint64",
    "ulong",
    "unichar",
    "ushort"
  ],
  "constants": ["true", "false", "null"],
  "comments": {
    "line": "//",
    "blockStart": "/*",
    "blockEnd": "*/"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "debugger": {
    "adapter": "lldb-dap",
    "configuration": {
      "request": "launch",
      "program": "${executable}",
      "cwd": "${workspace}",
      "stopOnEntry": false
    }
  }
}
