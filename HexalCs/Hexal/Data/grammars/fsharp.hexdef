{
  "id": "fsharp",
  "name": "F#",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".fs", ".fsi", ".fsx", ".fsscript"],
  "keywords": [
    "abstract",
    "and",
    "as",
    "assert",
    "base",
    "begin",
    "class",
    "default",
    "delegate",
    "do",
    "done",
    "downcast",
    "downto",
    "elif",
    "else",
    "end",
    "exception",
    "extern",
    "fixed",
    "for",
    "fun",
    "function",
    "global",
    "if",
    "in",
    "inherit",
    "inline",
    "interface",
    "internal",
    "lazy",
    "let",
    "match",
    "member",
    "module",
    "mutable",
    "namespace",
    "new",
    "not",
    "of",
    "open",
    "or",
    "override",
    "private",
    "public",
    "rec",
    "return",
    "static",
    "struct",
    "then",
    "to",
    "try",
    "type",
    "upcast",
    "use",
    "val",
    "void",
    "when",
    "while",
    "with",
    "yield"
  ],
  "controlStatements": [
    "assert",
    "begin",
    "do",
    "done",
    "elif",
    "else",
    "end",
    "finally",
    "for",
    "if",
    "in",
    "match",
    "return",
    "then",
    "to",
    "downto",
    "try",
    "when",
    "while",
    "with",
    "yield"
  ],
  "types": [
    "Async",
    "Result",
    "Task",
    "array",
    "bigint",
    "bool",
    "byte",
    "char",
    "decimal",
    "exn",
    "float",
    "float32",
    "int",
    "int16",
    "int32",
    "int64",
    "list",
    "nativeint",
    "obj",
    "option",
    "sbyte",
    "seq",
    "single",
    "string",
    "uint16",
    "uint32",
    "uint64",
    "unit"
  ],
  "constants": ["false", "None", "Some", "true"],
  "comments": {
    "line": "//",
    "blockStart": "(*",
    "blockEnd": "*)"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["=", "then", "else", "do", "->"],
  "unindentBefore": ["else", "elif", "|", "end"]
}
