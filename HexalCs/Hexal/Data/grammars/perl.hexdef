{
  "id": "perl",
  "name": "Perl",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".pl", ".pm", ".pod", ".psgi", ".t"],
  "keywords": [
    "bless",
    "caller",
    "chdir",
    "chmod",
    "chomp",
    "chop",
    "chown",
    "close",
    "defined",
    "delete",
    "die",
    "do",
    "each",
    "eval",
    "exists",
    "exit",
    "format",
    "get",
    "glob",
    "goto",
    "grep",
    "import",
    "join",
    "keys",
    "last",
    "lc",
    "lcfirst",
    "length",
    "local",
    "map",
    "mkdir",
    "my",
    "next",
    "no",
    "open",
    "our",
    "package",
    "pop",
    "pos",
    "print",
    "printf",
    "push",
    "read",
    "readdir",
    "readlink",
    "redo",
    "ref",
    "rename",
    "require",
    "return",
    "reverse",
    "rmdir",
    "say",
    "scalar",
    "select",
    "shift",
    "sort",
    "splice",
    "split",
    "sprintf",
    "state",
    "stat",
    "sub",
    "substr",
    "symlink",
    "syscall",
    "sysread",
    "system",
    "syswrite",
    "tell",
    "tie",
    "tied",
    "truncate",
    "uc",
    "ucfirst",
    "undef",
    "unlink",
    "unshift",
    "untie",
    "use",
    "values",
    "warn",
    "write"
  ],
  "controlStatements": [
    "continue",
    "default",
    "do",
    "else",
    "elsif",
    "for",
    "foreach",
    "given",
    "goto",
    "if",
    "last",
    "next",
    "redo",
    "unless",
    "until",
    "when",
    "while"
  ],
  "types": [],
  "constants": [
    "__DATA__",
    "__END__",
    "__FILE__",
    "__LINE__",
    "__PACKAGE__",
    "__SUB__",
    "undef"
  ],
  "comments": {
    "line": "#",
    "blockStart": "=pod",
    "blockEnd": "=cut"
  },
  "strings": {
    "quoteCharacters": ["\"", "'", "`"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["{", "[", "("],
  "unindentBefore": ["}", "]", ")"]
}
