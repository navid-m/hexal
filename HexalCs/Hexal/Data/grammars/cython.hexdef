{
    "id": "cython",
    "name": "Cython",
    "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
    "autoIndent": true,
    "autoClose": true,
    "indentAfter": [":"],
    "unindentBefore": ["elif", "else:", "except", "except:", "finally:", "case"],
    "extensions": [".pyx"],
    "keywords": [
        "and", "as", "assert", "async", "await", "class", "cdef",
        "cimport", "cpdef", "ctypedef", "def", "del", "extern", "from",
        "global", "import", "in", "include", "is", "lambda", "nonlocal",
        "not", "or", "pass", "with", "cppclass", "cppnamespace", "property",
        "public", "readonly", "api", "fused", "inline", "final"
    ],
    "controlStatements": [
        "break", "case", "continue", "elif", "else", "except", "finally",
        "for", "if", "match", "raise", "return", "try", "while", "yield"
    ],
    "types": [
        "bint", "bool", "bytearray", "bytes", "char", "complex", "dict",
        "double", "float", "frozenset", "int", "list", "long", "object",
        "set", "short", "size_t", "str", "tuple", "type", "uint",
        "ulong", "ushort", "void"
    ],
    "constants": ["True", "False", "None", "NULL", "__file__", "__name__"],
    "comments": {
        "line": "#"
    },
    "strings": {
        "quoteCharacters": ["\"", "'"],
        "escapeCharacter": "\\"
    },
    "numbers": true
}
