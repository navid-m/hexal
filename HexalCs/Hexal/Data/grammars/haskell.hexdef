{
    "id": "haskell",
    "name": "Haskell",
    "indentation": {
        "style": "spaces",
        "width": 2,
        "tabWidth": 4
    },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [
        ".hs",
        ".lhs",
        ".hsc"
    ],
    "keywords": [
        "as",
        "class",
        "data",
        "default",
        "deriving",
        "foreign",
        "hiding",
        "import",
        "infix",
        "infixl",
        "infixr",
        "instance",
        "module",
        "newtype",
        "qualified",
        "role",
        "type",
        "forall",
        "family",
        "pattern",
        "static",
        "stock",
        "anyclass",
        "via",
        "proc",
        "unsafe"
    ],
    "controlStatements": [
        "case",
        "do",
        "else",
        "if",
        "in",
        "let",
        "mdo",
        "of",
        "rec",
        "then",
        "where"
    ],
    "types": [
        "Bool",
        "Char",
        "Double",
        "Either",
        "Float",
        "IO",
        "Int",
        "Integer",
        "Maybe",
        "Ordering",
        "Rational",
        "String",
        "Word",
        "Word8",
        "Word16",
        "Word32",
        "Word64",
        "Int8",
        "Int16",
        "Int32",
        "Int64",
        "Functor",
        "Applicative",
        "Monad",
        "Foldable",
        "Traversable",
        "Show",
        "Eq",
        "Ord",
        "Read",
        "Enum",
        "Bounded",
        "Semigroup",
        "Monoid",
        "Num",
        "Fractional",
        "Integral",
        "Real",
        "Floating",
        "RealFrac"
    ],
    "constants": [
        "True",
        "False",
        "Nothing",
        "Just",
        "LT",
        "EQ",
        "GT"
    ],
    "comments": {
        "line": "--",
        "blockStart": "{-",
        "blockEnd": "-}"
    },
    "strings": {
        "quoteCharacters": [
            "\""
        ],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "indentAfter": [
        "where",
        "do",
        "of",
        "let"
    ],
    "formatter": {
        "command": "ormolu",
        "arguments": [
            "--stdin-input-file",
            "{path}"
        ],
        "input": "stdin",
        "output": "stdout",
        "timeout": 15000
    },
    "fallbackFormatter": {
        "command": "fourmolu",
        "arguments": [
            "--stdin-input-file",
            "{path}"
        ],
        "input": "stdin",
        "output": "stdout",
        "timeout": 15000
    }
}
