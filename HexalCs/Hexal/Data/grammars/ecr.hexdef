{
    "id": "ecr",
    "name": "ECR",
    "indentation": { "style": "spaces", "width": 2, "tabWidth": 2 },
    "autoIndent": true,
    "autoClose": true,
    "traditionalMarkupLanguage": true,
    "extensions": [".ecr"],
    "keywords": [
        "abstract", "alias", "annotation", "as", "asm", "class", "def",
        "delegate", "extend", "fun", "getter", "include", "instance_sizeof",
        "is_a", "lib", "macro", "module", "of", "offsetof", "out",
        "pointerof", "previous_def", "private", "property", "protected",
        "record", "require", "responds_to", "self", "setter", "sizeof",
        "spawn", "struct", "super", "type", "typeof", "uninitialized",
        "union", "verbatim", "with",
        "a", "abbr", "address", "article", "aside", "audio", "b",
        "blockquote", "body", "br", "button", "canvas", "caption", "code",
        "col", "colgroup", "dd", "del", "details", "dialog", "div", "dl",
        "dt", "em", "embed", "fieldset", "figcaption", "figure", "footer",
        "form", "h1", "h2", "h3", "h4", "h5", "h6", "head", "header", "hr",
        "html", "i", "iframe", "img", "input", "label", "legend", "li",
        "link", "main", "meta", "nav", "object", "ol", "optgroup", "option",
        "output", "p", "picture", "pre", "progress", "q", "script",
        "section", "select", "small", "source", "span", "strong", "style",
        "summary", "svg", "table", "tbody", "td", "template", "textarea",
        "tfoot", "th", "thead", "time", "title", "tr", "u", "ul", "video"
    ],
    "controlStatements": [
        "and", "begin", "break", "case", "do", "else", "elsif", "end",
        "ensure", "for", "if", "next", "not", "or", "rescue", "return",
        "select", "then", "unless", "until", "when", "while", "yield"
    ],
    "types": [
        "Array", "Atomic", "Bool", "Channel", "Char", "Class", "Comparable",
        "Enumerable", "Exception", "Fiber", "File", "Float32", "Float64",
        "Hash", "IO", "Int", "Int8", "Int16", "Int32", "Int64", "Int128",
        "Iterator", "JSON", "Math", "NamedTuple", "Nil", "Number", "Object",
        "Path", "Pointer", "Proc", "Process", "Random", "Range", "Reference",
        "Regex", "Set", "Slice", "Socket", "String", "Struct", "Symbol",
        "Time", "Tuple", "UInt", "UInt8", "UInt16", "UInt32", "UInt64",
        "UInt128", "Value",
        "accept", "action", "alt", "async", "autocomplete", "autofocus",
        "autoplay", "checked", "class", "cols", "colspan", "content",
        "controls", "datetime", "defer", "disabled", "download", "for",
        "form", "headers", "height", "hidden", "href", "id", "integrity",
        "label", "lang", "list", "loop", "max", "maxlength", "media",
        "method", "min", "minlength", "multiple", "muted", "name", "open",
        "pattern", "placeholder", "readonly", "rel", "required", "role",
        "rows", "rowspan", "selected", "size", "src", "srcset", "step",
        "style", "tabindex", "target", "title", "type", "value", "width",
        "wrap"
    ],
    "constants": [
        "ARGV", "ENV", "false", "nil", "PROGRAM_NAME", "STDERR", "STDIN",
        "STDOUT", "true"
    ],
    "comments": {
        "blockStart": "<%#",
        "blockEnd": "%>"
    },
    "strings": {
        "quoteCharacters": ["\"", "'"],
        "escapeCharacter": "\\"
    },
    "numbers": true
}
