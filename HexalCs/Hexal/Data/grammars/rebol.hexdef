{
    "id": "rebol",
    "name": "Rebol",
    "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [".reb", ".r3", ".rebol"],
    "keywords": [
        "all", "any", "append", "apply", "attempt", "bind", "break", "case",
        "catch", "change", "clear", "collect", "comment", "compose", "copy",
        "create", "debase", "enbase", "find", "first", "forall", "foreach",
        "forever", "forskip", "form", "func", "function", "get", "has",
        "head", "if", "insert", "join", "keep", "last", "length?", "load",
        "loop", "make", "map", "mold", "next", "none", "not", "object",
        "parse", "pick", "poke", "print", "probe", "reduce", "reform",
        "rejoin", "remove", "repeat", "replace", "return", "reverse",
        "select", "set", "skip", "some", "sort", "switch", "tail", "take",
        "throw", "to", "trim", "try", "unless", "until", "while", "write"
    ],
    "controlStatements": [
        "all", "any", "attempt", "break", "case", "catch", "either",
        "forall", "foreach", "forever", "forskip", "if", "loop", "not",
        "repeat", "return", "switch", "throw", "try", "unless", "until",
        "while"
    ],
    "types": [
        "action!", "binary!", "block!", "date!", "decimal!", "email!",
        "error!", "file!", "function!", "integer!", "issue!", "logic!",
        "map!", "native!", "none!", "object!", "op!", "paren!", "path!",
        "string!", "tag!", "tuple!", "url!", "vector!", "word!"
    ],
    "constants": ["false", "no", "none", "off", "on", "true", "yes"],
    "comments": {
        "line": ";"
    },
    "strings": {
        "quoteCharacters": ["\""],
        "escapeCharacter": "^"
    },
    "numbers": true,
    "indentAfter": ["[", "(", "{"],
    "unindentBefore": ["]", ")", "}"]
}
