{
    "id": "zig",
    "name": "Zig",
    "indentation": {
        "style": "spaces",
        "width": 4,
        "tabWidth": 4
    },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [
        ".zig",
        ".zon"
    ],
    "keywords": [
        "addrspace",
        "align",
        "allowzero",
        "and",
        "anyframe",
        "anytype",
        "asm",
        "async",
        "await",
        "callconv",
        "comptime",
        "const",
        "enum",
        "error",
        "export",
        "extern",
        "fn",
        "inline",
        "linksection",
        "noalias",
        "noinline",
        "nosuspend",
        "opaque",
        "or",
        "packed",
        "pub",
        "resume",
        "struct",
        "suspend",
        "test",
        "threadlocal",
        "union",
        "usingnamespace",
        "var",
        "volatile"
    ],
    "controlStatements": [
        "break",
        "catch",
        "continue",
        "defer",
        "else",
        "errdefer",
        "for",
        "if",
        "orelse",
        "return",
        "switch",
        "try",
        "unreachable",
        "while"
    ],
    "types": [
        "bool",
        "void",
        "noreturn",
        "type",
        "anyerror",
        "comptime_int",
        "comptime_float",
        "anyframe",
        "anyopaque",
        "i8",
        "i16",
        "i32",
        "i64",
        "i128",
        "u8",
        "u16",
        "u32",
        "u64",
        "u128",
        "isize",
        "usize",
        "f16",
        "f32",
        "f64",
        "f80",
        "f128",
        "c_char",
        "c_short",
        "c_ushort",
        "c_int",
        "c_uint",
        "c_long",
        "c_ulong",
        "c_longlong",
        "c_ulonglong",
        "c_longdouble"
    ],
    "constants": [
        "true",
        "false",
        "null",
        "undefined"
    ],
    "comments": {
        "line": "//"
    },
    "strings": {
        "quoteCharacters": [
            "\"",
            "'"
        ],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "formatter": {
        "command": "zig",
        "arguments": [
            "fmt",
            "--stdin"
        ],
        "input": "stdin",
        "output": "stdout",
        "timeout": 15000
    }
}
