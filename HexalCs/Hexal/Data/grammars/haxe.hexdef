{
    "id": "haxe",
    "name": "Haxe",
    "indentation": {
        "style": "spaces",
        "width": 4,
        "tabWidth": 4
    },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [
        ".hx"
    ],
    "keywords": [
        "abstract",
        "cast",
        "class",
        "dynamic",
        "enum",
        "extends",
        "extern",
        "final",
        "function",
        "implements",
        "import",
        "inline",
        "interface",
        "macro",
        "new",
        "operator",
        "overload",
        "override",
        "package",
        "private",
        "public",
        "static",
        "this",
        "typedef",
        "untyped",
        "using",
        "var",
        "from",
        "to"
    ],
    "controlStatements": [
        "break",
        "case",
        "catch",
        "continue",
        "default",
        "do",
        "else",
        "for",
        "if",
        "return",
        "switch",
        "throw",
        "try",
        "while"
    ],
    "types": [
        "Array",
        "Bool",
        "Class",
        "Date",
        "Dynamic",
        "Enum",
        "EnumValue",
        "Float",
        "Int",
        "Int64",
        "Iterator",
        "Map",
        "Null",
        "String",
        "UInt",
        "Void",
        "Any",
        "EReg",
        "Math",
        "Std",
        "Sys",
        "Type",
        "Xml"
    ],
    "constants": [
        "true",
        "false",
        "null"
    ],
    "comments": {
        "line": "//",
        "blockStart": "/*",
        "blockEnd": "*/"
    },
    "strings": {
        "quoteCharacters": [
            "\"",
            "'"
        ],
        "escapeCharacter": "\\"
    },
    "numbers": true
}
