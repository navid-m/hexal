{
  "id": "elvish",
  "name": "Elvish",
  "indentation": {
    "style": "spaces",
    "width": 4,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".elv"],
  "keywords": [
    "all",
    "and",
    "bool",
    "break",
    "catch",
    "cd",
    "coalesce",
    "continue",
    "count",
    "cp",
    "defer",
    "del",
    "each",
    "echo",
    "elif",
    "else",
    "eq",
    "eval",
    "exit",
    "filter",
    "finally",
    "fn",
    "for",
    "from-json",
    "ge",
    "get-env",
    "gt",
    "has-env",
    "if",
    "is",
    "le",
    "load",
    "ls",
    "lt",
    "map",
    "mkdir",
    "mod",
    "mv",
    "not",
    "not-eq",
    "nop",
    "num",
    "or",
    "peach",
    "print",
    "printf",
    "put",
    "pwd",
    "range",
    "re",
    "repeat",
    "return",
    "rm",
    "set",
    "set-env",
    "slurp",
    "some",
    "source",
    "str",
    "to-json",
    "try",
    "unset-env",
    "use",
    "use-mod",
    "var",
    "while",
    "with-env"
  ],
  "controlStatements": [
    "break",
    "catch",
    "continue",
    "defer",
    "elif",
    "else",
    "finally",
    "for",
    "if",
    "return",
    "try",
    "while"
  ],
  "types": [],
  "constants": ["false", "nil", "true"],
  "comments": {
    "line": "#"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": ["{", "[", "(", "for", "if", "try", "while"],
  "unindentBefore": ["}", "]", ")", "catch", "elif", "else", "finally"]
}
