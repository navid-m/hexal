{
    "id": "lisp",
    "name": "Common Lisp",
    "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [".lisp", ".lsp", ".cl", ".asd", ".ros"],
    "keywords": [
        "defun", "defmacro", "defvar", "defparameter", "defconstant",
        "defclass", "defgeneric", "defmethod", "defstruct", "defpackage",
        "deftype", "defsetf", "define-condition", "defsystem", "lambda",
        "let", "let*", "letrec", "flet", "labels", "macrolet",
        "symbol-macrolet", "multiple-value-bind", "destructuring-bind",
        "block", "return-from", "tagbody", "go", "progv", "handler-case",
        "handler-bind", "restart-case", "restart-bind", "unwind-protect",
        "catch", "throw", "eval-when", "locally", "the", "declare",
        "declaim", "proclaim", "in-package", "use-package", "require",
        "provide", "load", "compile-file", "format", "print", "princ",
        "prin1", "write", "write-line", "read", "read-line", "open",
        "close", "with-open-file", "with-output-to-string",
        "with-input-from-string", "loop", "do", "do*", "dolist", "dotimes",
        "mapcar", "mapc", "maplist", "mapcan", "reduce", "remove",
        "remove-if", "find", "find-if", "position", "count", "sort",
        "merge", "concatenate", "append", "nconc", "list", "cons", "car",
        "cdr", "first", "rest", "second", "third", "nth", "elt", "length",
        "reverse", "nreverse", "aref", "make-array", "vector", "string",
        "symbol", "intern", "funcall", "apply", "values",
        "multiple-value-list", "error", "signal", "warn", "cerror",
        "assert", "check-type", "and", "or", "not", "null", "eq", "eql",
        "equal", "equalp", "typep", "functionp", "consp", "listp",
        "numberp", "stringp", "symbolp", "hash-table", "make-hash-table",
        "gethash", "remhash", "package", "find-package"
    ],
    "controlStatements": [
        "if", "when", "unless", "cond", "case", "ecase", "ccase",
        "typecase", "etypecase", "and", "or", "not", "loop", "do", "do*",
        "dolist", "dotimes", "return", "return-from", "block", "tagbody",
        "go", "progn", "prog1", "prog2", "let", "let*", "flet", "labels",
        "multiple-value-bind", "handler-case", "unwind-protect", "catch",
        "throw", "lambda"
    ],
    "types": [
        "integer", "fixnum", "bignum", "float", "single-float",
        "double-float", "rational", "ratio", "complex", "number", "real",
        "string", "character", "symbol", "cons", "list", "vector", "array",
        "hash-table", "function", "stream", "package", "pathname", "t",
        "nil", "null"
    ],
    "constants": [
        "t", "nil", "pi", "most-positive-fixnum", "most-negative-fixnum",
        "lambda-parameters-limit", "call-arguments-limit",
        "array-dimension-limit"
    ],
    "comments": {
        "line": ";",
        "blockStart": "#|",
        "blockEnd": "|#"
    },
    "strings": {
        "quoteCharacters": ["\""],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "indentAfter": ["(", "["],
    "unindentBefore": [")", "]"]
}
