{
    "id": "blade",
    "name": "Blade",
    "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
    "autoIndent": true,
    "autoClose": true,
    "traditionalMarkupLanguage": true,
    "extensions": [".blade.php", ".blade"],
    "keywords": [
        "auth", "break", "case", "csrf", "component", "continue", "default",
        "each", "else", "elseif", "empty", "endcomponent", "endforeach",
        "endfor", "endif", "endisset", "endphp", "endsection", "endswitch",
        "endunless", "endverbatim", "env", "error", "extends", "for",
        "foreach", "forelse", "guest", "if", "include", "includeIf",
        "includeUnless", "includeWhen", "isset", "js", "json", "livewire",
        "method", "once", "php", "production", "props", "push", "section",
        "slot", "stack", "switch", "unless", "verbatim", "yield"
    ],
    "controlStatements": [
        "break", "case", "continue", "default", "else", "elseif", "empty",
        "endfor", "endforeach", "endif", "endisset", "endswitch",
        "endunless", "for", "foreach", "forelse", "if", "isset", "switch",
        "unless"
    ],
    "types": [],
    "constants": ["false", "null", "true"],
    "comments": {
        "blockStart": "{{--",
        "blockEnd": "--}}"
    },
    "strings": {
        "quoteCharacters": ["\"", "'"],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "indentAfter": ["@if", "@foreach", "@for", "@while", "@switch", "@section"],
    "unindentBefore": ["@endif", "@endforeach", "@endfor", "@endwhile", "@endswitch", "@endsection"]
}
