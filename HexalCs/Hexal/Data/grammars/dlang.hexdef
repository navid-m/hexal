{
    "id": "dlang",
    "name": "D",
    "indentation": {
        "style": "spaces",
        "width": 4,
        "tabWidth": 4
    },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [
        ".d",
        ".di"
    ],
    "keywords": [
        "abstract",
        "alias",
        "align",
        "asm",
        "assert",
        "auto",
        "body",
        "cast",
        "class",
        "const",
        "debug",
        "delegate",
        "deprecated",
        "enum",
        "export",
        "extern",
        "final",
        "function",
        "immutable",
        "import",
        "in",
        "inout",
        "interface",
        "invariant",
        "is",
        "lazy",
        "macro",
        "mixin",
        "module",
        "new",
        "nothrow",
        "out",
        "override",
        "package",
        "pragma",
        "private",
        "protected",
        "public",
        "pure",
        "ref",
        "scope",
        "shared",
        "static",
        "struct",
        "synchronized",
        "template",
        "this",
        "typeid",
        "typeof",
        "union",
        "unittest",
        "version",
        "volatile",
        "__FILE__",
        "__LINE__",
        "__gshared",
        "__traits",
        "__vector",
        "__parameters"
    ],
    "controlStatements": [
        "break",
        "case",
        "catch",
        "continue",
        "default",
        "do",
        "else",
        "finally",
        "for",
        "foreach",
        "foreach_reverse",
        "goto",
        "if",
        "return",
        "switch",
        "throw",
        "try",
        "while",
        "with"
    ],
    "types": [
        "bool",
        "byte",
        "char",
        "short",
        "int",
        "long",
        "ubyte",
        "ushort",
        "uint",
        "ulong",
        "cent",
        "ucent",
        "float",
        "double",
        "real",
        "ifloat",
        "idouble",
        "ireal",
        "cfloat",
        "cdouble",
        "creal",
        "void",
        "dchar",
        "wchar",
        "string",
        "wstring",
        "dstring",
        "size_t",
        "ptrdiff_t"
    ],
    "constants": [
        "true",
        "false",
        "null"
    ],
    "comments": {
        "line": "//",
        "blockStart": "/*",
        "blockEnd": "*/"
    },
    "strings": {
        "quoteCharacters": [
            "\"",
            "'",
            "`"
        ],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "formatter": {
        "command": "dfmt",
        "arguments": [],
        "input": "stdin",
        "output": "stdout",
        "timeout": 15000
    },
    "debugger": {
        "adapter": "lldb-dap",
        "configuration": {
            "request": "launch",
            "program": "${executable}",
            "cwd": "${workspace}",
            "stopOnEntry": false
        }
    }
}
