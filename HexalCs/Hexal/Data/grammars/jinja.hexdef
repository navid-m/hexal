{
    "id": "jinja",
    "name": "Jinja",
    "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
    "autoIndent": true,
    "autoClose": true,
    "traditionalMarkupLanguage": true,
    "extensions": [
        ".jinja", ".jinja2", ".j2", ".html.jinja", ".html.j2",
        ".jinja.html"
    ],
    "keywords": [
        "and", "as", "autoescape", "block", "call", "do", "else", "elif",
        "endautoescape", "endblock", "endcall", "endfilter", "endfor",
        "endif", "endmacro", "endraw", "endset", "endtrans", "endwith",
        "extends", "filter", "for", "from", "if", "ignore", "import", "in",
        "include", "is", "kwargs", "loop", "macro", "not", "or", "pluralize",
        "raw", "recursive", "scoped", "self", "set", "super", "trans",
        "varargs", "with"
    ],
    "controlStatements": [
        "and", "else", "elif", "endfor", "endif", "for", "if", "in", "is",
        "not", "or", "with"
    ],
    "types": [],
    "constants": [
        "False", "None", "True", "false", "none", "true"
    ],
    "comments": {
        "blockStart": "{#",
        "blockEnd": "#}"
    },
    "strings": {
        "quoteCharacters": ["\"", "'"],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "indentAfter": ["{% block", "{% for", "{% if", "{% macro", "{% with"],
    "unindentBefore": ["{% endblock", "{% endfor", "{% endif", "{% endmacro", "{% endwith"]
}
