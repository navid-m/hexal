{
    "id": "shell",
    "name": "Shell Script",
    "indentation": { "style": "spaces", "width": 4, "tabWidth": 8 },
    "autoIndent": true,
    "autoClose": true,
    "indentAfter": ["then", "do", "in", "else", "elif"],
    "unindentBefore": ["fi", "done", "esac", "else", "elif"],
    "extensions": [
        ".sh", ".bash", ".zsh", ".ksh", ".dash", ".ash", ".profile",
        ".bashrc", ".bash_profile", ".bash_login", ".bash_logout",
        ".bash_aliases", ".zshrc", ".zprofile", ".zshenv", ".zlogin",
        ".zlogout", ".kshrc"
    ],
    "keywords": [
        "alias", "autoload", "bg", "bind", "bindkey", "builtin", "caller",
        "cd", "command", "compgen", "complete", "compopt", "declare",
        "dirs", "disown", "echo", "emulate", "enable", "eval", "exec",
        "export", "fc", "fg", "float", "functions", "getopts", "hash",
        "history", "integer", "jobs", "kill", "let", "local", "logout",
        "mapfile", "popd", "print", "printf", "pushd", "pwd", "read",
        "readarray", "readonly", "rehash", "set", "setopt", "shift",
        "shopt", "source", "suspend", "test", "times", "trap", "type",
        "typeset", "ulimit", "umask", "unalias", "unfunction", "unhash",
        "unset", "unsetopt", "vared", "wait", "whence", "where", "which",
        "zcompile", "zle", "zmodload", "zparseopts", "zstyle"
    ],
    "controlStatements": [
        "break", "case", "continue", "do", "done", "elif", "else", "esac",
        "fi", "for", "function", "if", "in", "repeat", "return", "select",
        "then", "time", "until", "while"
    ],
    "types": [],
    "constants": ["true", "false"],
    "comments": {
        "line": "#"
    },
    "strings": {
        "quoteCharacters": ["\"", "'", "`"],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "formatter": {
        "command": "shfmt",
        "arguments": [],
        "input": "stdin",
        "output": "stdout"
    }
}
