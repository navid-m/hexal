{
    "id": "scss",
    "name": "SCSS",
    "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [".scss"],
    "keywords": [
        "use", "forward", "import", "mixin", "include", "extend",
        "function", "return", "if", "else", "each", "for", "while",
        "at-root", "content", "debug", "warn", "error", "supports", "media",
        "keyframes", "font-face", "layer", "container", "property",
        "charset", "namespace", "page", "viewport", "custom-media",
        "custom-selector", "var", "calc", "rgb", "rgba", "hsl", "hsla",
        "url", "attr", "env", "min", "max", "clamp", "color", "background",
        "display", "position", "margin", "padding", "border", "font",
        "width", "height", "top", "right", "bottom", "left", "flex",
        "grid", "gap", "align", "justify", "content", "opacity",
        "overflow", "transform", "transition", "animation", "box-shadow",
        "text", "line", "letter", "white", "cursor", "visibility", "float",
        "clear", "object", "filter", "mask", "clip", "columns", "outline",
        "resize", "table", "caption", "vertical", "direction", "unicode",
        "writing", "word", "hyphens", "tab", "pointer", "user", "z-index",
        "order", "place", "inset", "aspect", "backdrop", "list", "quotes",
        "scroll", "overscroll", "touch", "will", "isolation", "mix",
        "appearance", "accent", "caret", "break", "widows", "orphans"
    ],
    "controlStatements": [
        "if", "else", "each", "for", "while", "return", "include", "extend",
        "mixin", "function", "use", "forward", "import", "at-root"
    ],
    "types": [
        "px", "em", "rem", "ex", "ch", "vw", "vh", "vmin", "vmax", "cm",
        "mm", "in", "pt", "pc", "q", "deg", "rad", "grad", "turn", "s",
        "ms", "hz", "khz", "dpi", "dpcm", "dppx", "fr", "%"
    ],
    "constants": [
        "important", "inherit", "initial", "unset", "revert",
        "revert-layer", "none", "auto", "normal", "transparent",
        "currentColor", "true", "false", "null"
    ],
    "comments": {
        "line": "//",
        "blockStart": "/*",
        "blockEnd": "*/"
    },
    "strings": {
        "quoteCharacters": ["\"", "'"],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "formatter": {
        "command": "prettier",
        "arguments": ["--stdin-filepath", "{path}"],
        "input": "stdin",
        "output": "stdout",
        "timeout": 15000
    }
}
