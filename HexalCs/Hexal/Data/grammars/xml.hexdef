{
    "id": "xml",
    "name": "XML",
    "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
    "extensions": [".xml", ".csproj", ".rpp"],
    "keywords": [
        "xml", "version", "encoding", "standalone", "xmlns", "xsi",
        "schemaLocation", "noNamespaceSchemaLocation"
    ],
    "controlStatements": [],
    "types": [],
    "constants": ["true", "false"],
    "comments": {
        "blockStart": "<!--",
        "blockEnd": "-->"
    },
    "strings": {
        "quoteCharacters": ["\"", "'"]
    },
    "numbers": true
}
