{
    "id": "xsd",
    "name": "XML Schema",
    "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
    "autoIndent": true,
    "autoClose": true,
    "traditionalMarkupLanguage": true,
    "extensions": [".xsd"],
    "keywords": [
        "schema", "element", "attribute", "complexType", "simpleType",
        "sequence", "choice", "all", "group", "attributeGroup",
        "restriction", "extension", "import", "include", "redefine",
        "annotation", "documentation", "appinfo", "complexContent",
        "simpleContent", "list", "union", "any", "anyAttribute", "unique",
        "key", "keyref", "selector", "field", "notation",
        "targetNamespace", "elementFormDefault", "attributeFormDefault",
        "version", "id", "name", "type", "ref", "minOccurs", "maxOccurs",
        "nillable", "default", "fixed", "use", "form", "abstract", "block",
        "final", "mixed", "substitutionGroup", "base", "value"
    ],
    "controlStatements": [],
    "types": [
        "string", "boolean", "decimal", "float", "double", "duration",
        "dateTime", "time", "date", "gYearMonth", "gYear", "gMonthDay",
        "gDay", "gMonth", "hexBinary", "base64Binary", "anyURI", "QName",
        "NOTATION", "normalizedString", "token", "language", "NMTOKEN",
        "NMTOKENS", "Name", "NCName", "ID", "IDREF", "IDREFS", "ENTITY",
        "ENTITIES", "integer", "nonPositiveInteger", "negativeInteger",
        "long", "int", "short", "byte", "nonNegativeInteger",
        "unsignedLong", "unsignedInt", "unsignedShort", "unsignedByte",
        "positiveInteger", "anySimpleType", "anyType", "anyAtomicType",
        "xs"
    ],
    "constants": ["true", "false"],
    "comments": {
        "blockStart": "<!--",
        "blockEnd": "-->"
    },
    "strings": {
        "quoteCharacters": ["\"", "'"]
    },
    "numbers": true
}
