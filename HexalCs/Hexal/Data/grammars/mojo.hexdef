{
  "id": "mojo",
  "name": "Mojo",
  "indentation": {
    "style": "spaces",
    "width": 4,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".mojo"],
  "keywords": [
    "alias",
    "as",
    "assert",
    "async",
    "await",
    "borrowed",
    "class",
    "constrained",
    "def",
    "decorator",
    "del",
    "fn",
    "from",
    "global",
    "import",
    "inout",
    "is",
    "lambda",
    "let",
    "local",
    "nonlocal",
    "owned",
    "raises",
    "ref",
    "self",
    "static",
    "struct",
    "trait",
    "var",
    "__mlir_type",
    "__mlir_op",
    "__mlir_region",
    "_"
  ],
  "controlStatements": [
    "break",
    "continue",
    "elif",
    "else",
    "except",
    "finally",
    "for",
    "if",
    "in",
    "pass",
    "raise",
    "return",
    "try",
    "while",
    "with",
    "yield"
  ],
  "types": [
    "AnyType",
    "Bool",
    "Int",
    "Int8",
    "Int16",
    "Int32",
    "Int64",
    "Int128",
    "UInt",
    "UInt8",
    "UInt16",
    "UInt32",
    "UInt64",
    "UInt128",
    "Float16",
    "Float32",
    "Float64",
    "BFloat16",
    "String",
    "StringLiteral",
    "DType",
    "DevicePassable",
    "Movable",
    "Copyable",
    "RegisterPassable",
    "Scalar",
    "SIMD",
    "Error",
    "List",
    "Dict",
    "Optional",
    "Tuple"
  ],
  "constants": ["True", "False", "None"],
  "comments": {
    "line": "#"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "indentAfter": [":"],
  "unindentBefore": ["elif", "else:", "except", "except:", "finally:"],
  "formatter": {
    "command": "mojo",
    "arguments": ["format", "-q", "-"],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
