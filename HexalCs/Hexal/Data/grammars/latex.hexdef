{
    "id": "latex",
    "name": "LaTeX",
    "indentation": {
        "style": "spaces",
        "width": 2,
        "tabWidth": 4
    },
    "autoIndent": false,
    "autoClose": true,
    "extensions": [
        ".tex",
        ".sty",
        ".cls",
        ".dtx",
        ".ins",
        ".ltx",
        ".bbx",
        ".cbx"
    ],
    "keywords": [
        "documentclass",
        "usepackage",
        "RequirePackage",
        "begin",
        "end",
        "section",
        "subsection",
        "subsubsection",
        "paragraph",
        "subparagraph",
        "chapter",
        "part",
        "label",
        "ref",
        "eqref",
        "pageref",
        "autoref",
        "cite",
        "citep",
        "citet",
        "bibliography",
        "bibliographystyle",
        "addbibresource",
        "includegraphics",
        "caption",
        "title",
        "author",
        "date",
        "maketitle",
        "tableofcontents",
        "listoffigures",
        "listoftables",
        "newcommand",
        "renewcommand",
        "providecommand",
        "DeclareMathOperator",
        "def",
        "let",
        "newenvironment",
        "renewenvironment",
        "input",
        "include",
        "includeonly",
        "item",
        "footnote",
        "textbf",
        "textit",
        "emph",
        "underline",
        "texttt",
        "textrm",
        "textsf",
        "textsc",
        "textsl",
        "textup",
        "textmd",
        "textnormal",
        "mathbf",
        "mathit",
        "mathrm",
        "mathsf",
        "mathtt",
        "mathcal",
        "mathbb",
        "frac",
        "dfrac",
        "tfrac",
        "sqrt",
        "sum",
        "prod",
        "int",
        "iint",
        "iiint",
        "lim",
        "log",
        "ln",
        "exp",
        "sin",
        "cos",
        "tan",
        "cot",
        "sec",
        "csc",
        "arcsin",
        "arccos",
        "arctan",
        "sinh",
        "cosh",
        "tanh",
        "alpha",
        "beta",
        "gamma",
        "delta",
        "epsilon",
        "varepsilon",
        "zeta",
        "eta",
        "theta",
        "vartheta",
        "iota",
        "kappa",
        "lambda",
        "mu",
        "nu",
        "xi",
        "omicron",
        "pi",
        "varpi",
        "rho",
        "varrho",
        "sigma",
        "varsigma",
        "tau",
        "upsilon",
        "phi",
        "varphi",
        "chi",
        "psi",
        "omega",
        "Gamma",
        "Delta",
        "Theta",
        "Lambda",
        "Xi",
        "Pi",
        "Sigma",
        "Upsilon",
        "Phi",
        "Psi",
        "Omega",
        "infty",
        "partial",
        "nabla",
        "times",
        "cdot",
        "div",
        "pm",
        "mp",
        "leq",
        "geq",
        "neq",
        "approx",
        "equiv",
        "sim",
        "simeq",
        "propto",
        "to",
        "rightarrow",
        "leftarrow",
        "leftrightarrow",
        "Rightarrow",
        "Leftarrow",
        "Leftrightarrow",
        "mapsto",
        "forall",
        "exists",
        "neg",
        "land",
        "lor",
        "cup",
        "cap",
        "subset",
        "supset",
        "in",
        "notin",
        "emptyset",
        "varnothing",
        "aleph",
        "hbar",
        "ell",
        "Re",
        "Im",
        "langle",
        "rangle",
        "lfloor",
        "rfloor",
        "lceil",
        "rceil",
        "quad",
        "qquad",
        "hspace",
        "vspace",
        "newline",
        "linebreak",
        "pagebreak",
        "cleardoublepage",
        "noindent",
        "indent",
        "centering",
        "raggedright",
        "raggedleft",
        "large",
        "Large",
        "LARGE",
        "huge",
        "Huge",
        "small",
        "footnotesize",
        "scriptsize",
        "tiny",
        "normalsize",
        "bfseries",
        "itshape",
        "ttfamily",
        "rmfamily",
        "sffamily",
        "mdseries",
        "upshape",
        "color",
        "textcolor",
        "colorbox",
        "fcolorbox",
        "definecolor",
        "usetheme",
        "usefonttheme",
        "useinnertheme",
        "useoutertheme",
        "setbeamertemplate",
        "frame",
        "frametitle",
        "framesubtitle",
        "pause",
        "only",
        "uncover",
        "visible",
        "invisible",
        "alt",
        "onslide",
        "draw",
        "node",
        "path",
        "fill",
        "filldraw",
        "coordinate",
        "get",
        "set",
        "pgfmathsetmacro",
        "addplot",
        "axis",
        "legend",
        "xlabel",
        "ylabel",
        "zlabel",
        "xmin",
        "xmax",
        "ymin",
        "ymax",
        "zmin",
        "zmax",
        "domain",
        "samples",
        "smooth",
        "thick",
        "thin",
        "dashed",
        "dotted",
        "solid",
        "opacity",
        "circle",
        "rectangle",
        "ellipse",
        "arc",
        "plot",
        "coordinates",
        "addlegendentry"
    ],
    "controlStatements": [
        "if",
        "else",
        "elseif",
        "fi",
        "unless",
        "or",
        "loop",
        "repeat",
        "foreach",
        "while",
        "for",
        "break",
        "continue",
        "return"
    ],
    "types": [
        "document",
        "itemize",
        "enumerate",
        "description",
        "figure",
        "table",
        "tabular",
        "equation",
        "align",
        "gather",
        "multline",
        "split",
        "cases",
        "matrix",
        "pmatrix",
        "bmatrix",
        "vmatrix",
        "Vmatrix",
        "verbatim",
        "lstlisting",
        "minted",
        "tikzpicture",
        "axis",
        "frame",
        "block",
        "alertblock",
        "exampleblock",
        "columns",
        "column",
        "minipage",
        "center",
        "flushleft",
        "flushright",
        "quote",
        "quotation",
        "verse"
    ],
    "constants": [
        "true",
        "false"
    ],
    "comments": {
        "line": "%"
    },
    "strings": {
        "quoteCharacters": []
    },
    "numbers": true,
    "formatter": {
        "command": "tex-fmt",
        "arguments": [
            "--stdin"
        ],
        "input": "stdin",
        "output": "stdout",
        "timeout": 15000
    }
}
