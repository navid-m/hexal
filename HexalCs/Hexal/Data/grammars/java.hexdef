{
    "id": "java",
    "name": "Java",
    "indentation": {
        "style": "spaces",
        "width": 4,
        "tabWidth": 4
    },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [
        ".java"
    ],
    "keywords": [
        "abstract",
        "assert",
        "class",
        "const",
        "enum",
        "extends",
        "final",
        "goto",
        "implements",
        "import",
        "instanceof",
        "interface",
        "native",
        "new",
        "package",
        "private",
        "protected",
        "public",
        "static",
        "strictfp",
        "super",
        "synchronized",
        "this",
        "throws",
        "transient",
        "volatile",
        "var",
        "record",
        "sealed",
        "permits",
        "non-sealed",
        "module",
        "requires",
        "exports",
        "opens",
        "uses",
        "provides",
        "to",
        "with",
        "transitive",
        "open"
    ],
    "controlStatements": [
        "break",
        "case",
        "catch",
        "continue",
        "default",
        "do",
        "else",
        "finally",
        "for",
        "if",
        "return",
        "switch",
        "throw",
        "try",
        "while",
        "yield"
    ],
    "types": [
        "boolean",
        "byte",
        "char",
        "double",
        "float",
        "int",
        "long",
        "short",
        "void",
        "String",
        "Object",
        "Integer",
        "Long",
        "Short",
        "Byte",
        "Double",
        "Float",
        "Boolean",
        "Character",
        "Number",
        "Class",
        "Enum",
        "Record",
        "List",
        "ArrayList",
        "Map",
        "HashMap",
        "Set",
        "HashSet",
        "Queue",
        "Deque",
        "Optional",
        "Stream",
        "Iterable",
        "Iterator",
        "Comparable",
        "Runnable",
        "Thread",
        "Exception",
        "RuntimeException",
        "Error"
    ],
    "constants": [
        "true",
        "false",
        "null"
    ],
    "comments": {
        "line": "//",
        "blockStart": "/*",
        "blockEnd": "*/"
    },
    "strings": {
        "quoteCharacters": [
            "\"",
            "'"
        ],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "formatter": {
        "command": "google-java-format",
        "arguments": [
            "-"
        ],
        "input": "stdin",
        "output": "stdout",
        "timeout": 15000
    }
}
