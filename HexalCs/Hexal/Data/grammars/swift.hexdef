{
    "id": "swift",
    "name": "Swift",
    "indentation": {
        "style": "spaces",
        "width": 4,
        "tabWidth": 4
    },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [
        ".swift"
    ],
    "keywords": [
        "associatedtype",
        "class",
        "deinit",
        "enum",
        "extension",
        "fileprivate",
        "func",
        "import",
        "init",
        "inout",
        "internal",
        "let",
        "open",
        "operator",
        "private",
        "protocol",
        "public",
        "rethrows",
        "static",
        "struct",
        "subscript",
        "typealias",
        "var",
        "as",
        "Any",
        "is",
        "super",
        "self",
        "Self",
        "async",
        "await",
        "actor",
        "some",
        "any",
        "nonisolated",
        "isolated",
        "mutating",
        "nonmutating",
        "convenience",
        "dynamic",
        "final",
        "indirect",
        "infix",
        "lazy",
        "optional",
        "override",
        "postfix",
        "prefix",
        "required",
        "unowned",
        "weak",
        "willSet",
        "didSet",
        "get",
        "set"
    ],
    "controlStatements": [
        "break",
        "case",
        "catch",
        "continue",
        "default",
        "defer",
        "do",
        "else",
        "fallthrough",
        "for",
        "guard",
        "if",
        "in",
        "repeat",
        "return",
        "switch",
        "throw",
        "throws",
        "try",
        "where",
        "while"
    ],
    "types": [
        "Any",
        "AnyObject",
        "Bool",
        "Character",
        "Double",
        "Float",
        "Float80",
        "Int",
        "Int8",
        "Int16",
        "Int32",
        "Int64",
        "UInt",
        "UInt8",
        "UInt16",
        "UInt32",
        "UInt64",
        "String",
        "Substring",
        "Array",
        "Dictionary",
        "Set",
        "Optional",
        "Result",
        "Void",
        "Never",
        "Error",
        "Codable",
        "Encodable",
        "Decodable",
        "Equatable",
        "Hashable",
        "Comparable",
        "Identifiable",
        "Collection",
        "Sequence",
        "IteratorProtocol",
        "Range",
        "ClosedRange"
    ],
    "constants": [
        "true",
        "false",
        "nil"
    ],
    "comments": {
        "line": "//",
        "blockStart": "/*",
        "blockEnd": "*/"
    },
    "strings": {
        "quoteCharacters": [
            "\""
        ],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "formatter": {
        "command": "swift-format",
        "arguments": [
            "format",
            "-"
        ],
        "input": "stdin",
        "output": "stdout",
        "timeout": 15000
    }
}
