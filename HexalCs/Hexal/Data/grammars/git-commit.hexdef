{
    "id": "git-commit",
    "name": "Git Commit Message",
    "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
    "autoIndent": false,
    "autoClose": false,
    "extensions": [],
    "fileNames": ["COMMIT_EDITMSG", "MERGE_MSG", "TAG_EDITMSG"],
    "keywords": [
        "build", "chore", "ci", "docs", "feat", "fix", "perf", "refactor",
        "revert", "style", "test", "wip"
    ],
    "controlStatements": [],
    "types": [],
    "constants": [],
    "linePatterns": [
        {
            "pattern": "^(?i)[a-z][a-z0-9_-]*(\\([^)]*\\))?:",
            "kind": "keyword"
        }
    ],
    "comments": {
        "line": "#"
    },
    "strings": {
        "quoteCharacters": []
    },
    "numbers": false
}
