{
    "id": "raku",
    "name": "Raku",
    "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [
        ".raku", ".rakumod", ".rakudoc", ".p6", ".pm6", ".pl6", ".t6"
    ],
    "keywords": [
        "also", "augment", "class", "constant", "enum", "grammar", "has",
        "import", "is", "let", "method", "module", "multi", "need", "of",
        "only", "our", "proto", "returns", "role", "state", "sub",
        "submethod", "subset", "supersede", "temp", "unit", "use", "where"
    ],
    "controlStatements": [
        "CATCH", "CONTROL", "ENTER", "KEEP", "LAST", "LEAVE", "NEXT",
        "QUIT", "UNDO", "catch", "default", "die", "do", "else", "elsif",
        "for", "given", "if", "last", "loop", "next", "proceed", "redo",
        "repeat", "return", "succeed", "try", "unless", "until", "when",
        "while"
    ],
    "types": [
        "Any", "Array", "Associative", "Bag", "BagHash", "Bool", "Callable",
        "Channel", "Cool", "Date", "DateTime", "Duration", "Hash", "Instant",
        "Int", "Iterable", "Junction", "List", "Map", "Mix", "MixHash", "Mu",
        "Num", "Numeric", "Positional", "Promise", "Rat", "Real", "Set",
        "SetHash", "Str", "Supply", "Tap", "UInt"
    ],
    "constants": ["False", "Nil", "True"],
    "comments": {
        "line": "#"
    },
    "strings": {
        "quoteCharacters": ["\"", "'"],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "indentAfter": ["{", "[", "("],
    "unindentBefore": ["}", "]", ")"]
}
