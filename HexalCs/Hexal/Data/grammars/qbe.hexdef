{
    "id": "qbe",
    "name": "QBE IR",
    "indentation": {
        "style": "spaces",
        "width": 2,
        "tabWidth": 4
    },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [
        ".ssa"
    ],
    "keywords": [
        "data",
        "function",
        "type",
        "export",
        "thread",
        "section",
        "env",
        "align"
    ],
    "controlStatements": [
        "add",
        "sub",
        "div",
        "mul",
        "neg",
        "udiv",
        "rem",
        "urem",
        "or",
        "xor",
        "and",
        "sar",
        "shr",
        "shl",
        "storeb",
        "storeh",
        "storew",
        "storel",
        "stores",
        "stored",
        "loadb",
        "loadsb",
        "loadub",
        "loadh",
        "loadsh",
        "loaduh",
        "loadw",
        "loadsw",
        "loaduw",
        "loadl",
        "loads",
        "loadd",
        "blit",
        "alloc4",
        "alloc8",
        "alloc16",
        "ceqd",
        "ceql",
        "ceqs",
        "ceqw",
        "cged",
        "cges",
        "cgtd",
        "cgts",
        "cled",
        "cles",
        "cltd",
        "clts",
        "cned",
        "cnel",
        "cnes",
        "cnew",
        "cod",
        "cos",
        "csgel",
        "csgew",
        "csgtl",
        "csgtw",
        "cslel",
        "cslew",
        "csltl",
        "csltw",
        "cugel",
        "cugew",
        "cugtl",
        "cugtw",
        "culel",
        "culew",
        "cultl",
        "cultw",
        "cuod",
        "cuos",
        "dtosi",
        "dtoui",
        "exts",
        "extsb",
        "extsh",
        "extsw",
        "extub",
        "extuh",
        "extuw",
        "sltof",
        "ultof",
        "stosi",
        "stoui",
        "swtof",
        "uwtof",
        "truncd",
        "cast",
        "copy",
        "call",
        "vastart",
        "vaarg",
        "phi",
        "hlt",
        "jmp",
        "jnz",
        "ret"
    ],
    "types": [
        "w",
        "l",
        "s",
        "d",
        "b",
        "h",
        "sb",
        "ub",
        "sh",
        "uh"
    ],
    "constants": [],
    "comments": {
        "line": "#"
    },
    "strings": {
        "quoteCharacters": [
            "\""
        ],
        "escapeCharacter": "\\"
    },
    "numbers": true
}
