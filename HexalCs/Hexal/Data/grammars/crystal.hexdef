{
    "id": "crystal",
    "name": "Crystal",
    "indentation": {
        "style": "spaces",
        "width": 2,
        "tabWidth": 2
    },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [
        ".cr"
    ],
    "keywords": [
        "abstract",
        "alias",
        "annotation",
        "as",
        "asm",
        "class",
        "def",
        "delegate",
        "extend",
        "fun",
        "getter",
        "include",
        "instance_sizeof",
        "is_a",
        "lib",
        "macro",
        "module",
        "of",
        "offsetof",
        "out",
        "pointerof",
        "previous_def",
        "private",
        "property",
        "protected",
        "record",
        "require",
        "responds_to",
        "self",
        "setter",
        "sizeof",
        "spawn",
        "struct",
        "super",
        "type",
        "typeof",
        "uninitialized",
        "union",
        "verbatim",
        "with"
    ],
    "controlStatements": [
        "and",
        "begin",
        "break",
        "case",
        "do",
        "else",
        "elsif",
        "end",
        "ensure",
        "for",
        "if",
        "next",
        "not",
        "or",
        "rescue",
        "return",
        "select",
        "then",
        "unless",
        "until",
        "when",
        "while",
        "yield"
    ],
    "types": [
        "Atomic",
        "Array",
        "Base64",
        "BigDecimal",
        "BigInt",
        "Bool",
        "Channel",
        "Char",
        "Class",
        "Comparable",
        "Digest",
        "Dir",
        "Enumerable",
        "Exception",
        "Fiber",
        "File",
        "Float32",
        "Float64",
        "Hash",
        "HTTP",
        "IO",
        "Int",
        "Int8",
        "Int16",
        "Int32",
        "Int64",
        "Int128",
        "Iterator",
        "JSON",
        "Log",
        "Math",
        "Mutex",
        "NamedTuple",
        "Nil",
        "Number",
        "Object",
        "Path",
        "Pointer",
        "Proc",
        "Process",
        "Random",
        "Range",
        "Reference",
        "Regex",
        "Set",
        "Slice",
        "Socket",
        "Span",
        "StaticArray",
        "String",
        "Struct",
        "Symbol",
        "System",
        "Time",
        "Tuple",
        "UInt",
        "UInt8",
        "UInt16",
        "UInt32",
        "UInt64",
        "UInt128",
        "URI",
        "UUID",
        "Value",
        "YAML"
    ],
    "constants": [
        "__DIR__",
        "__END_LINE__",
        "__FILE__",
        "__LINE__",
        "ARGV",
        "Crystal",
        "ENV",
        "false",
        "nil",
        "PROGRAM_NAME",
        "STDERR",
        "STDIN",
        "STDOUT",
        "true",
        "VERSION"
    ],
    "comments": {
        "line": "#"
    },
    "strings": {
        "quoteCharacters": [
            "\"",
            "'"
        ],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "indentAfter": [
        "begin",
        "case",
        "do",
        "else",
        "ensure",
        "rescue",
        "then"
    ],
    "unindentBefore": [
        "else",
        "elsif",
        "end",
        "ensure",
        "rescue",
        "when"
    ],
    "formatter": {
        "command": "crystal",
        "arguments": [
            "tool",
            "format",
            "-"
        ],
        "input": "stdin",
        "output": "stdout",
        "timeout": 15000
    }
}
