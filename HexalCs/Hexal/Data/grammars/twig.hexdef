{
    "id": "twig",
    "name": "Twig",
    "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
    "autoIndent": true,
    "autoClose": true,
    "traditionalMarkupLanguage": true,
    "extensions": [".twig", ".twig.html"],
    "keywords": [
        "and", "apply", "as", "autoescape", "block", "cache", "constant",
        "deprecated", "do", "else", "elseif", "embed", "endapply",
        "endautoescape", "endblock", "endcache", "endembed", "endfilter",
        "endfor", "endif", "endmacro", "endsandbox", "endset",
        "endspaceless", "endtrans", "endverbatim", "endwith", "extends",
        "filter", "flush", "for", "from", "guard", "if", "ignore",
        "import", "in", "include", "is", "macro", "not", "or", "raw",
        "sandbox", "set", "spaceless", "trans", "trans_default_domain",
        "use", "verbatim", "with", "defined", "empty", "even", "iterable",
        "none", "null", "odd", "same", "true", "false"
    ],
    "controlStatements": [
        "if", "else", "elseif", "endif", "for", "endfor", "in", "with",
        "endwith", "block", "endblock", "macro", "endmacro", "include",
        "extends", "embed", "endembed", "import", "from", "set", "endset",
        "apply", "endapply", "filter", "endfilter", "autoescape",
        "endautoescape", "sandbox", "endsandbox", "spaceless",
        "endspaceless", "verbatim", "endverbatim", "cache", "endcache",
        "trans", "endtrans"
    ],
    "types": ["string", "number", "bool", "iterable", "mapping", "sequence", "object", "callable"],
    "constants": ["true", "false", "null", "none"],
    "comments": {
        "blockStart": "{#",
        "blockEnd": "#}"
    },
    "strings": {
        "quoteCharacters": ["\"", "'"],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "indentAfter": [
        "{% block", "{% for", "{% if", "{% macro", "{% embed",
        "{% with", "{% apply", "{% filter", "{% autoescape",
        "{% sandbox", "{% spaceless", "{% cache", "{% trans"
    ],
    "unindentBefore": [
        "{% endblock", "{% endfor", "{% endif", "{% endmacro",
        "{% endembed", "{% endwith", "{% endapply", "{% endfilter",
        "{% endautoescape", "{% endsandbox", "{% endspaceless",
        "{% endcache", "{% endtrans"
    ]
}
