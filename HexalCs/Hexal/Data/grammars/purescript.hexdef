{
    "id": "purescript",
    "name": "PureScript",
    "indentation": {
        "style": "spaces",
        "width": 2,
        "tabWidth": 4
    },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [
        ".purs"
    ],
    "keywords": [
        "ado",
        "as",
        "case",
        "class",
        "data",
        "derive",
        "do",
        "else",
        "forall",
        "foreign",
        "hiding",
        "if",
        "import",
        "in",
        "infix",
        "infixl",
        "infixr",
        "instance",
        "kind",
        "let",
        "mdo",
        "module",
        "newtype",
        "of",
        "qualified",
        "rec",
        "role",
        "then",
        "type",
        "where"
    ],
    "controlStatements": [
        "ado",
        "case",
        "do",
        "else",
        "if",
        "in",
        "let",
        "mdo",
        "of",
        "rec",
        "then",
        "where"
    ],
    "types": [
        "Aff",
        "Array",
        "Boolean",
        "Char",
        "Constraint",
        "Effect",
        "Either",
        "Int",
        "Maybe",
        "Number",
        "Ordering",
        "Record",
        "Row",
        "String",
        "Tuple",
        "Type",
        "Unit"
    ],
    "constants": [
        "EQ",
        "GT",
        "Just",
        "LT",
        "Left",
        "Nothing",
        "Right",
        "false",
        "true",
        "unit"
    ],
    "comments": {
        "line": "--",
        "blockStart": "{-",
        "blockEnd": "-}"
    },
    "strings": {
        "quoteCharacters": [
            "\"",
            "'"
        ],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "indentAfter": [
        "ado",
        "do",
        "else",
        "let",
        "of",
        "then",
        "where"
    ],
    "unindentBefore": [
        "else",
        "in"
    ]
}
