{
  "id": "javascript",
  "name": "JavaScript",
  "indentation": {
    "style": "spaces",
    "width": 2,
    "tabWidth": 4
  },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".js", ".mjs", ".cjs", ".es6"],
  "keywords": [
    "as",
    "async",
    "await",
    "class",
    "const",
    "debugger",
    "delete",
    "export",
    "extends",
    "from",
    "function",
    "get",
    "import",
    "in",
    "instanceof",
    "let",
    "new",
    "of",
    "set",
    "static",
    "super",
    "this",
    "typeof",
    "var",
    "void",
    "with"
  ],
  "controlStatements": [
    "break",
    "case",
    "catch",
    "continue",
    "default",
    "do",
    "else",
    "finally",
    "for",
    "if",
    "return",
    "switch",
    "throw",
    "try",
    "while",
    "yield"
  ],
  "types": [
    "Array",
    "ArrayBuffer",
    "BigInt",
    "Boolean",
    "DataView",
    "Date",
    "Error",
    "EvalError",
    "Function",
    "Int8Array",
    "Int16Array",
    "Int32Array",
    "JSON",
    "Map",
    "Math",
    "Number",
    "Object",
    "Promise",
    "Proxy",
    "RangeError",
    "ReferenceError",
    "Reflect",
    "RegExp",
    "Set",
    "SharedArrayBuffer",
    "String",
    "Symbol",
    "SyntaxError",
    "TypeError",
    "Uint8Array",
    "Uint8ClampedArray",
    "Uint16Array",
    "Uint32Array",
    "URIError",
    "WeakMap",
    "WeakSet",
    "console",
    "globalThis"
  ],
  "constants": ["true", "false", "null", "undefined", "NaN", "Infinity"],
  "comments": {
    "line": "//",
    "blockStart": "/*",
    "blockEnd": "*/"
  },
  "strings": {
    "quoteCharacters": ["\"", "'", "`"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "formatter": {
    "command": "prettier",
    "arguments": ["--stdin-filepath", "{path}"],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  },
  "fallbackFormatter": {
    "command": "biome",
    "arguments": ["format", "--stdin-file-path", "{path}"],
    "input": "stdin",
    "output": "stdout",
    "timeout": 15000
  }
}
