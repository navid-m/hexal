{
    "id": "ocaml",
    "name": "OCaml",
    "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [".ml", ".mli", ".mll", ".mly", ".eliom", ".eliomi"],
    "keywords": [
        "and", "as", "assert", "begin", "class", "constraint", "do", "done",
        "downto", "effect", "else", "end", "exception", "external", "for",
        "fun", "function", "functor", "if", "in", "include", "inherit",
        "initializer", "lazy", "let", "match", "method", "module", "mutable",
        "new", "nonrec", "object", "of", "open", "perform", "private",
        "rec", "sig", "struct", "then", "to", "try", "type", "val",
        "virtual", "when", "while", "with"
    ],
    "controlStatements": [
        "begin", "do", "done", "downto", "else", "end", "for", "if", "in",
        "match", "then", "to", "try", "when", "while", "with"
    ],
    "types": [
        "array", "bool", "bytes", "char", "exn", "float", "format", "int",
        "int32", "int64", "lazy_t", "list", "nativeint", "option",
        "ref", "result", "string", "unit"
    ],
    "constants": [
        "Error", "None", "Ok", "Some", "false", "true"
    ],
    "comments": {
        "blockStart": "(*",
        "blockEnd": "*)"
    },
    "strings": {
        "quoteCharacters": ["\""],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "indentAfter": ["let", "match", "if", "then", "else", "try", "fun", "function", "struct", "sig"],
    "unindentBefore": ["end", "else", "in", "with"]
}
