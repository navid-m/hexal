{
    "id": "qml",
    "name": "QML",
    "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
    "autoIndent": true,
    "autoClose": true,
    "extensions": [".qml", ".qmltypes", ".qmlproject"],
    "keywords": [
        "import", "as", "property", "signal", "function", "readonly",
        "default", "alias", "enum", "on", "required", "inline", "pragma",
        "id", "parent", "Component", "onCompleted", "onDestruction",
        "Behavior", "State", "Transition", "PropertyChanges", "Binding"
    ],
    "controlStatements": [
        "if", "else", "for", "while", "do", "switch", "case", "default",
        "break", "continue", "return", "try", "catch", "finally", "throw"
    ],
    "types": [
        "string", "int", "real", "bool", "double", "color", "url", "var",
        "variant", "list", "font", "date", "point", "rect", "size",
        "vector2d", "vector3d", "vector4d", "quaternion", "matrix4x4",
        "QtObject", "Item", "Rectangle", "Text", "Image", "MouseArea",
        "Component", "Connections", "Loader", "Repeater", "ListView",
        "GridView", "Column", "Row", "Grid", "Flow", "StackView",
        "ApplicationWindow", "Window", "Button", "Label", "TextField",
        "TextArea", "CheckBox", "RadioButton", "Slider", "ProgressBar",
        "ScrollView", "Flickable", "Animation", "NumberAnimation",
        "ColorAnimation", "PropertyAnimation", "SequentialAnimation",
        "ParallelAnimation", "Timer"
    ],
    "constants": ["true", "false", "null", "undefined", "Qt"],
    "comments": {
        "line": "//",
        "blockStart": "/*",
        "blockEnd": "*/"
    },
    "strings": {
        "quoteCharacters": ["\"", "'", "`"],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "indentAfter": ["{", "["],
    "unindentBefore": ["}", "]"]
}
