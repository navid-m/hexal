    ],
    "comments": {
        "line": "--",
        "blockStart": "/*",
        "blockEnd": "*/"
    },
    "strings": {
        "quoteCharacters": [
            "'",
            "\"",
            "`"
        ],
        "escapeCharacter": "\\"
    },
    "numbers": true,
    "formatter": {
        "command": "sqlfluff",
        "arguments": [
            "format",
            "--dialect",
            "ansi",
            "--disable-progress-bar",
            "-"
        ],
        "input": "stdin",
        "output": "stdout",
        "timeout": 15000
    }
}
