{
  "id": "cpp",
  "name": "C++",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 8 },
  "autoIndent": true,
  "autoClose": true,
  "extensions": [".h", ".cpp", ".hpp"],
  "keywords": [
    "alignas",
    "alignof",
    "auto",
    "class",
    "concept",
    "consteval",
    "constexpr",
    "constinit",
    "const",
    "decltype",
    "explicit",
    "export",
    "friend",
    "import",
    "inline",
    "module",
    "mutable",
    "namespace",
    "noexcept",
    "operator",
    "override",
    "final",
    "private",
    "protected",
    "public",
    "register",
    "requires",
    "static",
    "static_assert",
    "struct",
    "template",
    "thread_local",
    "typedef",
    "typename",
    "union",
    "using",
    "virtual",
    "volatile",
    "co_await",
    "co_return",
    "co_yield"
  ],
  "controlStatements": [
    "break",
    "case",
    "catch",
    "continue",
    "default",
    "do",
    "else",
    "for",
    "goto",
    "if",
    "return",
    "sizeof",
    "switch",
    "throw",
    "try",
    "typeid",
    "while"
  ],
  "types": [
    "bool",
    "char",
    "char8_t",
    "char16_t",
    "char32_t",
    "double",
    "float",
    "int",
    "int8_t",
    "int16_t",
    "int32_t",
    "int64_t",
    "intptr_t",
    "long",
    "ptrdiff_t",
    "short",
    "signed",
    "size_t",
    "ssize_t",
    "uint8_t",
    "uint16_t",
    "uint32_t",
    "uint64_t",
    "uintptr_t",
    "unsigned",
    "void",
    "wchar_t"
  ],
  "constants": ["true", "false", "nullptr", "NULL", "EOF"],
  "comments": {
    "line": "//",
    "blockStart": "/*",
    "blockEnd": "*/"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "formatter": {
    "command": "clang-format",
    "arguments": ["--assume-filename={file}"],
    "input": "stdin",
    "output": "stdout"
  },
  "debugger": {
    "adapter": "lldb-dap",
    "configuration": {
      "request": "launch",
      "program": "${executable}",
      "cwd": "${workspace}",
      "stopOnEntry": false
    }
  },
  "fallbackLsp": {
    "name": "ccls",
    "command": "ccls",
    "arguments": [],
    "languageId": "cpp"
  }
}
