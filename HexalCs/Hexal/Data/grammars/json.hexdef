{
    "id": "json",
    "name": "JSON",
    "indentation": { "style": "spaces", "width": 2, "tabWidth": 4 },
    "extensions": [
        ".json", ".jsonc", ".jsonl", ".ndjson", ".geojson", ".har",
        ".webmanifest"
    ],
    "keywords": [],
    "controlStatements": [],
    "types": [],
    "constants": ["true", "false", "null"],
    "comments": {
        "line": "//",
        "blockStart": "/*",
        "blockEnd": "*/"
    },
    "strings": {
        "quoteCharacters": ["\""],
        "escapeCharacter": "\\"
    },
    "numbers": true
}
