<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>Hexal</RootNamespace>
    <AssemblyName>hexal</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SelfContained>true</SelfContained>
    
    <!-- The editor is a single-threaded, latency-sensitive console application. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>

    <!-- Keep the door open for NativeAOT, trimming, and predictable startup. -->
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <!-- NLua is exercised by the published NativeAOT build, but its package
         assembly includes analyzer-only trim/AOT warnings. Suppress those
         third-party assembly-level warnings without hiding warnings from our
         own code. -->
    <NoWarn>$(NoWarn);IL2104;IL3053</NoWarn>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- Native Lua 5.4 runtime with per-platform libraries. Kept behind the
         Scripting/ abstraction so the editor core has no Lua dependency. -->
    <PackageReference Include="NLua" Version="1.7.9" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled grammars and language-server plugins are deployed into the
         portable data/ layout next to the executable. Keep them out of the
         single-file bundle so they can still be discovered on disk at
         runtime (HexalPaths looks next to the executable first). -->
    <Content Include="Data\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>data/%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <!--
    Obfuscation is opt-in at publish time:

      dotnet tool restore
      dotnet publish -c Release -r linux-x64 -p:SelfContained=true \
        -p:PublishSingleFile=true -p:Obfuscate=true

    Obfuscar only renames metadata; string hiding and IL optimizations stay
    off so the obfuscated build behaves (and performs) like the original.

    The target runs after PrepareForBundle, so the obfuscated copy is what the
    single-file bundler consumes. The build output itself is left untouched,
    which keeps incremental builds, tests and benchmarks working normally.
    Requires the Obfuscar local tool (see .config/dotnet-tools.json).
  -->
  <Target Name="_HexalObfuscateAssembly"
          AfterTargets="PrepareForBundle"
          Condition="'$(Obfuscate)' == 'true'">
    <Error Condition="'$(PublishSingleFile)' != 'true'"
           Text="Obfuscate=true requires PublishSingleFile=true." />

    <PropertyGroup>
      <_HexalObfuscateInPath>$([System.IO.Path]::GetFullPath('$(TargetDir)'))</_HexalObfuscateInPath>
      <_HexalObfuscateOutPath>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)obfuscated'))</_HexalObfuscateOutPath>
      <_HexalObfuscateConfig>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)obfuscar.xml'))</_HexalObfuscateConfig>
    </PropertyGroup>

    <MakeDir Directories="$(_HexalObfuscateOutPath)" />

    <ItemGroup>
      <_HexalObfuscarConfigLine Include="&lt;?xml version=&quot;1.0&quot; encoding=&quot;utf-8&quot;?&gt;" />
      <_HexalObfuscarConfigLine Include="&lt;Obfuscator&gt;" />
      <_HexalObfuscarConfigLine Include="  &lt;Var name=&quot;InPath&quot; value=&quot;$(_HexalObfuscateInPath)&quot; /&gt;" />
      <_HexalObfuscarConfigLine Include="  &lt;Var name=&quot;OutPath&quot; value=&quot;$(_HexalObfuscateOutPath)&quot; /&gt;" />
      <_HexalObfuscarConfigLine Include="  &lt;Var name=&quot;KeepPublicApi&quot; value=&quot;false&quot; /&gt;" />
      <_HexalObfuscarConfigLine Include="  &lt;Var name=&quot;HidePrivateApi&quot; value=&quot;true&quot; /&gt;" />
      <_HexalObfuscarConfigLine Include="  &lt;Var name=&quot;RenameFields&quot; value=&quot;true&quot; /&gt;" />
      <_HexalObfuscarConfigLine Include="  &lt;Var name=&quot;RenameProperties&quot; value=&quot;true&quot; /&gt;" />
      <_HexalObfuscarConfigLine Include="  &lt;Var name=&quot;RenameEvents&quot; value=&quot;true&quot; /&gt;" />
      <_HexalObfuscarConfigLine Include="  &lt;Var name=&quot;HideStrings&quot; value=&quot;false&quot; /&gt;" />
      <_HexalObfuscarConfigLine Include="  &lt;Var name=&quot;OptimizeMethods&quot; value=&quot;false&quot; /&gt;" />
      <_HexalObfuscarConfigLine Include="  &lt;Var name=&quot;SuppressIldasm&quot; value=&quot;false&quot; /&gt;" />
      <_HexalObfuscarConfigLine Include="  &lt;Var name=&quot;RegenerateDebugInfo&quot; value=&quot;false&quot; /&gt;" />
      <_HexalObfuscarConfigLine Include="  &lt;Module file=&quot;$(_HexalObfuscateInPath)$(TargetFileName)&quot; /&gt;" />
      <_HexalObfuscarConfigLine Include="  &lt;AssemblySearchPath path=&quot;$(_HexalObfuscateInPath)&quot; /&gt;" />
      <_HexalObfuscarConfigLine Include="&lt;/Obfuscator&gt;" />
    </ItemGroup>

    <WriteLinesToFile File="$(_HexalObfuscateConfig)"
                      Lines="@(_HexalObfuscarConfigLine)"
                      Overwrite="true" />

    <Exec Command="dotnet tool run obfuscar.console &quot;$(_HexalObfuscateConfig)&quot;"
          WorkingDirectory="$(MSBuildProjectDirectory)" />

    <!-- Feed the obfuscated assembly to the single-file bundler instead of
         the one produced by the compiler. -->
    <ItemGroup>
      <_HexalAssemblyToBundle Include="@(FilesToBundle)"
                              Condition="'%(Filename)%(Extension)' == '$(TargetFileName)'" />
      <FilesToBundle Remove="@(_HexalAssemblyToBundle)" />
      <FilesToBundle Include="$(_HexalObfuscateOutPath)/$(TargetFileName)"
                     RelativePath="%(_HexalAssemblyToBundle.RelativePath)" />
    </ItemGroup>
  </Target>

</Project>
