{
  "id": "lua",
  "name": "Lua",
  "indentation": { "style": "spaces", "width": 4, "tabWidth": 4 },
  "autoIndent": true,
  "autoClose": true,
  "indentAfter": ["then", "do", "else", "repeat"],
  "unindentBefore": ["end", "else", "elseif", "until"],
  "extensions": [".lua"],
  "keywords": [
    "and",
    "end",
    "function",
    "local",
    "not",
    "or",
    "repeat",
    "then",
    "until",
    "self"
  ],
  "controlStatements": [
    "break",
    "do",
    "else",
    "elseif",
    "for",
    "goto",
    "if",
    "in",
    "return",
    "while"
  ],
  "types": [
    "boolean",
    "function",
    "nil",
    "number",
    "string",
    "table",
    "thread",
    "userdata"
  ],
  "constants": ["true", "false", "nil", "_G", "_VERSION"],
  "comments": {
    "line": "--",
    "blockStart": "--[[",
    "blockEnd": "]]"
  },
  "strings": {
    "quoteCharacters": ["\"", "'"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "formatter": {
    "command": "stylua",
    "arguments": ["-"],
    "input": "stdin",
    "output": "stdout"
  }
}
