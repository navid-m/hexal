    "__BITS__",
    "__FILE__",
    "__LINE__",
    "__DATE__",
    "__TIME__",
    "__UTC_DATE__",
    "__UTC_TIME__",
    "__POSIX_TIME__",
    "__OUTPUT_FORMAT__",
    "__DEBUG_FORMAT__"
  ],
  "comments": {
    "line": ";"
  },
  "strings": {
    "quoteCharacters": ["\"", "'", "`"],
    "escapeCharacter": "\\"
  },
  "numbers": true,
  "debugger": {
    "adapter": "lldb-dap",
    "configuration": {
      "request": "launch",
      "program": "${executable}",
      "cwd": "${workspace}",
      "stopOnEntry": false
    }
  }
